<?xml version="1.0" encoding="utf-8"?>
<!-- Only the pinned WebView2 SDK and Windows reference packs are allowed; map assets remain local. -->
<configuration>
  <packageSources><clear /><add key="nuget.org" value="https://api.nuget.org/v3/index.json" /></packageSources>
  <packageSourceMapping><packageSource key="nuget.org"><package pattern="Microsoft.Web.WebView2" /><package pattern="Microsoft.Windows.SDK.NET.Ref" /><package pattern="Microsoft.Windows.SDK.NET.Ref.*" /><package pattern="Microsoft.Windows.SDK.BuildTools" /></packageSource></packageSourceMapping>
</configuration>
