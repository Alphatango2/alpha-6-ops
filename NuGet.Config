<!-- Identity uses maintained OIDC and PostgreSQL packages. Domain/replay projects remain dependency-free. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
