<Application x:Class="Alpha6Ops.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DashboardStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Yellow" Color="#F9D928" />
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource OpsButton}" />
      <Style TargetType="TextBox" BasedOn="{StaticResource OpsInput}" />
      <Style TargetType="ComboBox" BasedOn="{StaticResource OpsCombo}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
