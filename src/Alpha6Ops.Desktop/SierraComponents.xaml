<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Alpha6Ops.Desktop">
  <Style x:Key="S4.Body" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Body}"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/></Style>
  <Style x:Key="S4.ApplicationTitle" TargetType="TextBlock" BasedOn="{StaticResource S4.Body}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Application}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="S4.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource S4.Body}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Page}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="S4.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource S4.Body}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Section}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="S4.Metric" TargetType="TextBlock" BasedOn="{StaticResource S4.Body}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Metric}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
  <Style x:Key="S4.Secondary" TargetType="TextBlock" BasedOn="{StaticResource S4.Body}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Secondary}"/><Setter Property="Foreground" Value="{StaticResource S4.TextSecondary}"/></Style>
  <Style x:Key="S4.Metadata" TargetType="TextBlock" BasedOn="{StaticResource S4.Body}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Metadata}"/><Setter Property="Foreground" Value="{StaticResource S4.TextMuted}"/></Style>
  <Style x:Key="S4.Label" TargetType="TextBlock" BasedOn="{StaticResource S4.Secondary}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Label}"/></Style>
  <Style x:Key="S4.Status" TargetType="TextBlock" BasedOn="{StaticResource S4.Secondary}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Status}"/></Style>
  <Style x:Key="S4.Caption" TargetType="TextBlock" BasedOn="{StaticResource S4.Metadata}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Caption}"/></Style>
  <Style x:Key="S4.Focus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="2" BorderThickness="2" CornerRadius="4" BorderBrush="{StaticResource S4.SierraYellow}" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="S4.Button" TargetType="Button"><Style.Resources><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Secondary}"/></Style></Style.Resources>
    <Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Secondary}"/><Setter Property="MinHeight" Value="{StaticResource S4.ControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource S4.Space.Control}"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/><Setter Property="Background" Value="{StaticResource S4.SurfaceSecondary}"/><Setter Property="BorderBrush" Value="{StaticResource S4.Divider}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource S4.Focus}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource S4.Radius.Control}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource S4.TextMuted}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="S4.PrimaryButton" TargetType="Button" BasedOn="{StaticResource S4.Button}"><Setter Property="Background" Value="{StaticResource S4.SierraYellow}"/><Setter Property="Foreground" Value="{StaticResource S4.AppBackground}"/><Setter Property="BorderBrush" Value="{StaticResource S4.SierraYellow}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="S4.SecondaryButton" TargetType="Button" BasedOn="{StaticResource S4.Button}"/>
  <Style x:Key="S4.IconButton" TargetType="Button" BasedOn="{StaticResource S4.Button}"><Setter Property="Width" Value="{StaticResource S4.ControlHeight}"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style x:Key="S4.NavigationItem" TargetType="Button" BasedOn="{StaticResource S4.Button}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource S4.TextSecondary}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="46"/>
    <Style.Triggers><DataTrigger Binding="{Binding IsCompact,RelativeSource={RelativeSource AncestorType=local:SierraShell}}" Value="True"><Setter Property="Padding" Value="4,10"/></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource S4.Selection}"/><Setter Property="Foreground" Value="{StaticResource S4.SierraYellow}"/><Setter Property="BorderBrush" Value="{StaticResource S4.SierraYellow}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="S4.Input" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Body}"/><Setter Property="MinHeight" Value="{StaticResource S4.ControlHeight}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/><Setter Property="CaretBrush" Value="{StaticResource S4.TextPrimary}"/><Setter Property="Background" Value="{StaticResource S4.SurfaceSecondary}"/><Setter Property="BorderBrush" Value="{StaticResource S4.Divider}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SelectionBrush" Value="{StaticResource S4.Information}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource S4.Radius.Control}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource S4.SierraYellow}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="S4.SearchInput" TargetType="TextBox" BasedOn="{StaticResource S4.Input}"/>
  <Style x:Key="S4.DataPanel" TargetType="Border"><Setter Property="Background" Value="{StaticResource S4.SurfacePrimary}"/><Setter Property="Padding" Value="{StaticResource S4.Space.Panel}"/><Setter Property="CornerRadius" Value="{StaticResource S4.Radius.Panel}"/></Style>
  <Style x:Key="S4.StatusIndicator" TargetType="Ellipse"><Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/><Setter Property="Fill" Value="{StaticResource S4.TextMuted}"/></Style>
  <Style x:Key="S4.OperationalAlert" TargetType="Border" BasedOn="{StaticResource S4.DataPanel}"><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="{StaticResource S4.Warning}"/></Style>
  <Style x:Key="S4.Table" TargetType="DataGrid"><Style.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource S4.Body}"><Setter Property="FontSize" Value="{StaticResource S4.Type.Table}"/></Style></Style.Resources><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource S4.Selection}"/></Trigger></Style.Triggers></Style></Setter.Value></Setter><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Table}"/><Setter Property="Background" Value="{StaticResource S4.SurfacePrimary}"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/><Setter Property="RowBackground" Value="{StaticResource S4.SurfacePrimary}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource S4.SurfaceSecondary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource S4.Divider}"/><Setter Property="RowHeight" Value="38"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource S4.SurfacePrimary}"/><Setter Property="Foreground" Value="{StaticResource S4.TextMuted}"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource S4.Divider}"/></Style></Setter.Value></Setter></Style>
  <Style x:Key="S4.Tabs" TargetType="TabControl"><Setter Property="Background" Value="{StaticResource S4.SurfacePrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/></Style>
  <Style x:Key="S4.Tab" TargetType="TabItem"><Style.Resources><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Secondary}"/></Style></Style.Resources><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="Foreground" Value="{StaticResource S4.TextSecondary}"/><Setter Property="Padding" Value="16,10"/><Setter Property="FocusVisualStyle" Value="{StaticResource S4.Focus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource S4.SierraYellow}"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="S4.DropdownItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="{StaticResource S4.ControlHeight}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{StaticResource S4.SurfaceElevated}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource S4.Selection}"/><Setter Property="Foreground" Value="{StaticResource S4.SierraYellow}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="S4.Dropdown" TargetType="ComboBox"><Style.Resources><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Secondary}"/></Style></Style.Resources>
    <Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Body}"/><Setter Property="MinHeight" Value="{StaticResource S4.ControlHeight}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/><Setter Property="Background" Value="{StaticResource S4.SurfaceSecondary}"/><Setter Property="BorderBrush" Value="{StaticResource S4.Divider}"/><Setter Property="FocusVisualStyle" Value="{StaticResource S4.Focus}"/><Setter Property="ItemContainerStyle" Value="{StaticResource S4.DropdownItem}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource S4.SurfaceSecondary}" BorderBrush="{StaticResource S4.Divider}" BorderThickness="1" CornerRadius="{StaticResource S4.Radius.Control}"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template>
        <Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,8,36,8" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource S4.TextSecondary}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid>
      </ToggleButton>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource S4.SurfaceElevated}" BorderBrush="{StaticResource S4.Divider}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="S4.Tooltip" TargetType="ToolTip"><Style.Resources><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Secondary}"/></Style></Style.Resources><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="FontSize" Value="{StaticResource S4.Type.Secondary}"/><Setter Property="Background" Value="{StaticResource S4.SurfaceElevated}"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderBrush" Value="{StaticResource S4.Divider}"/></Style>
  <Style x:Key="S4.Dialog" TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource S4.Font}"/><Setter Property="Background" Value="{StaticResource S4.AppBackground}"/><Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}"/><Setter Property="Width" Value="{StaticResource S4.DialogWidth}"/><Setter Property="SizeToContent" Value="Height"/></Style>
  <Style x:Key="S4.State" TargetType="local:SierraStatePanel">
    <Setter Property="Padding" Value="{StaticResource S4.Space.Panel}"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:SierraStatePanel"><StackPanel Margin="{TemplateBinding Padding}" MaxWidth="500" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
      <TextBlock x:Name="StateLabel" Text="EMPTY" Style="{StaticResource S4.Metadata}" Margin="0,0,0,12"/>
      <TextBlock Text="{TemplateBinding Heading}" Style="{StaticResource S4.SectionHeader}" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding Message}" Style="{StaticResource S4.Secondary}" TextWrapping="Wrap" Margin="0,8,0,16"/>
      <ProgressBar x:Name="Loading" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource S4.Information}"/>
      <ContentPresenter Margin="0,8,0,0"/>
    </StackPanel><ControlTemplate.Triggers>
      <Trigger Property="Kind" Value="Loading"><Setter TargetName="StateLabel" Property="Text" Value="LOADING"/><Setter TargetName="Loading" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="Kind" Value="Unavailable"><Setter TargetName="StateLabel" Property="Text" Value="UNAVAILABLE"/></Trigger>
      <Trigger Property="Kind" Value="Stale"><Setter TargetName="StateLabel" Property="Text" Value="LAST AVAILABLE DATA"/><Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource S4.Warning}"/></Trigger>
      <Trigger Property="Kind" Value="Error"><Setter TargetName="StateLabel" Property="Text" Value="COULD NOT LOAD"/><Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource S4.Critical}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
