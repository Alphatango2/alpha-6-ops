<UserControl x:Class="Alpha6Ops.Desktop.DispatchWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#03090D" Foreground="#F2F6FA">
 <Grid Margin="0,0,20,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Rectangle Width="5" Fill="{StaticResource OpsYellow}" Margin="0,1,12,1"/><TextBlock Text="DISPATCH" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold"/><Border Background="#102231" BorderBrush="#3D657D" BorderThickness="1" CornerRadius="3" Padding="9,3" Margin="14,3,0,3"><TextBlock x:Name="ReleaseStateText" Text="NO RELEASE" Foreground="#9BC8E8" FontSize="10" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="PERSONAL FLIGHT RELEASE" Style="{StaticResource OpsCaption}" FontSize="11" Margin="17,5,0,0"/></StackPanel><Button Grid.Column="1" Content="BACK TO DASHBOARD" Style="{StaticResource OpsExit}" Padding="16,9" Click="Back_Click"/></Grid>
  <Grid Grid.Row="2">
   <Border x:Name="EmptyState" Style="{StaticResource OpsPanel}" Padding="38"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" MaxWidth="620"><TextBlock Text="PREPARE YOUR NEXT FLIGHT" FontFamily="Bahnschrift SemiCondensed" FontSize="28"/><TextBlock Text="Import your latest SimBrief operational flight plan here, review the release, then accept it for Flight Tracking." Foreground="#AFC0CC" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="NAVIGRAPH ALIAS / SIMBRIEF USERNAME" Style="{StaticResource OpsCaption}" Margin="0,25,0,7"/><DockPanel MaxWidth="540" HorizontalAlignment="Left"><Button x:Name="ImportButton" DockPanel.Dock="Right" Content="IMPORT FROM SIMBRIEF" Style="{StaticResource OpsPrimary}" Padding="20,11" Margin="10,0,0,0" Click="Import_Click"/><TextBox x:Name="SimBriefUsernameBox" Padding="11,9" MinWidth="245"/></DockPanel><Button Content="ENTER FLIGHT MANUALLY" Style="{StaticResource OpsExit}" HorizontalAlignment="Left" Padding="20,9" Margin="0,12,0,0" Click="Manual_Click"/><TextBlock x:Name="ImportStatusText" Foreground="#9BC8E8" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel><Border Grid.Column="2" Background="#07131B" BorderBrush="#29404F" BorderThickness="1" CornerRadius="4" Padding="24" VerticalAlignment="Center"><StackPanel><TextBlock Text="DISPATCH WORKFLOW" Style="{StaticResource OpsCaption}"/><TextBlock Text="1   IMPORT" Foreground="{StaticResource OpsYellow}" FontSize="19" Margin="0,18,0,0"/><TextBlock Text="Bring the latest briefing into Dispatch." Foreground="#9FB2C0" Margin="25,3,0,0"/><TextBlock Text="2   REVIEW" FontSize="19" Margin="0,18,0,0"/><TextBlock Text="Verify route, schedule, aircraft, fuel and payload." Foreground="#9FB2C0" Margin="25,3,0,0" TextWrapping="Wrap"/><TextBlock Text="3   ACCEPT" FontSize="19" Margin="0,18,0,0"/><TextBlock Text="Release the assignment to Flight Tracking." Foreground="#9FB2C0" Margin="25,3,0,0"/></StackPanel></Border></Grid></Border>
   <Grid x:Name="ReviewState" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource OpsPanel}" Padding="24"><StackPanel><Grid><StackPanel><TextBlock Text="SIMBRIEF RELEASE REVIEW" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewFlightNumberText" FontSize="34" FontFamily="Bahnschrift SemiCondensed" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2A2508" BorderBrush="#8F7C13" BorderThickness="1" CornerRadius="3" Padding="9,4"><TextBlock Text="DRAFT" Foreground="{StaticResource OpsYellow}"/></Border></Grid><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ReviewOriginText" FontSize="31" Foreground="{StaticResource OpsYellow}"/><TextBlock Text="DEPARTURE" Style="{StaticResource OpsCaption}"/></StackPanel><TextBlock Grid.Column="1" Text="→" FontSize="25" HorizontalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="ReviewDestinationText" FontSize="31" Foreground="{StaticResource OpsYellow}" HorizontalAlignment="Right"/><TextBlock Text="ARRIVAL" Style="{StaticResource OpsCaption}" HorizontalAlignment="Right"/></StackPanel></Grid><UniformGrid Columns="3" Margin="0,23,0,0"><StackPanel Margin="0,0,12,15"><TextBlock Text="AIRCRAFT" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewAircraftText" FontSize="15" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="0,0,12,15"><TextBlock Text="REGISTRATION" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewRegistrationText" FontSize="15" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="DISTANCE" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewDistanceText" FontSize="15" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="SCHEDULED OUT" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewDepartureText" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="SCHEDULED IN" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewArrivalText" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="DURATION" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewDurationText" Margin="0,5,0,0"/></StackPanel></UniformGrid><Border Background="#07131B" BorderBrush="#29404F" BorderThickness="1" Padding="14" Margin="0,22,0,0"><StackPanel><Grid><TextBlock Text="FULL FILED ROUTE" Style="{StaticResource OpsCaption}"/><Button HorizontalAlignment="Right" Content="COPY ROUTE" Style="{StaticResource OpsLink}" Padding="9,3" Click="CopyDraftRoute_Click" AutomationProperties.Name="Copy full filed route"/></Grid><TextBlock x:Name="ReviewRouteText" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource OpsPanel}" Padding="24"><StackPanel><TextBlock Text="RELEASE DATA" FontSize="20"/><UniformGrid Columns="2" Margin="0,20,0,0"><StackPanel Margin="0,0,10,18"><TextBlock Text="RAMP FUEL" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewRampFuelText" FontSize="16"/></StackPanel><StackPanel><TextBlock Text="TRIP FUEL" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewTripFuelText" FontSize="16"/></StackPanel><StackPanel><TextBlock Text="PAYLOAD" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewPayloadText" FontSize="16"/></StackPanel><StackPanel><TextBlock Text="PASSENGERS" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ReviewPassengersText" FontSize="16"/></StackPanel></UniformGrid><TextBlock x:Name="ReviewNoticeText" Foreground="#9BC8E8" TextWrapping="Wrap" Margin="0,24,0,0"/><Button x:Name="AcceptButton" Content="ACCEPT FLIGHT" Style="{StaticResource OpsPrimary}" Padding="22,12" Margin="0,25,0,0" Click="Accept_Click"/><Button x:Name="DraftOfpButton" Content="VIEW OFP" Style="{StaticResource OpsExit}" Padding="18,10" Margin="0,10,0,0" Click="DraftOfp_Click"/><Button x:Name="RefreshButton" Content="REFRESH FROM SIMBRIEF" Style="{StaticResource OpsExit}" Padding="18,10" Margin="0,10,0,0" Click="Refresh_Click"/><Button x:Name="CancelReviewButton" Content="CANCEL REVIEW" Style="{StaticResource OpsExit}" Padding="18,10" Margin="0,10,0,0" Click="CancelReview_Click"/></StackPanel></Border>
   </Grid>
   <Grid x:Name="ActiveState" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource OpsPanel}" Padding="24"><StackPanel><TextBlock Text="CURRENT FLIGHT RELEASE" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="FlightNumberText" FontSize="34" Margin="0,7,0,0"/><Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="OriginText" FontSize="31" Foreground="{StaticResource OpsYellow}"/><TextBlock Text="DEPARTURE" Style="{StaticResource OpsCaption}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="DestinationText" FontSize="31" Foreground="{StaticResource OpsYellow}" HorizontalAlignment="Right"/><TextBlock Text="ARRIVAL" Style="{StaticResource OpsCaption}" HorizontalAlignment="Right"/></StackPanel></Grid><UniformGrid Columns="2" Margin="0,27,0,0"><StackPanel><TextBlock Text="SCHEDULED OUT" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="DepartureText" FontSize="16"/></StackPanel><StackPanel><TextBlock Text="SCHEDULED IN" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="ArrivalText" FontSize="16"/></StackPanel><StackPanel Margin="0,18,0,0"><TextBlock Text="AIRCRAFT" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="AircraftText" FontSize="16"/></StackPanel><StackPanel Margin="0,18,0,0"><TextBlock Text="SOURCE" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="SourceText" FontSize="16"/></StackPanel></UniformGrid><WrapPanel Margin="0,28,0,0"><Button Content="VIEW FLIGHT TRACKING" Style="{StaticResource OpsPrimary}" Padding="20,11" Margin="0,0,10,0" Click="Tracking_Click"/><Button x:Name="ActiveOfpButton" Content="VIEW OFP" Style="{StaticResource OpsExit}" Padding="18,10" Margin="0,0,10,0" Click="ActiveOfp_Click"/><Button Content="IMPORT NEW RELEASE" Style="{StaticResource OpsExit}" Padding="18,10" Click="ImportNew_Click"/></WrapPanel></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource OpsPanel}" Padding="24"><StackPanel><TextBlock Text="RELEASE STATUS" FontSize="19"/><TextBlock Text="This flight is active. A newly imported release remains a draft until you accept it." Foreground="#AFC0CC" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="CurrentStateText" Foreground="{StaticResource OpsYellow}" FontSize="21" Margin="0,24,0,0"/></StackPanel></Border></Grid>
  </Grid>
 </Grid>
</UserControl>
