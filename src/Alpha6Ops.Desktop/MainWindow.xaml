<Window x:Class="Alpha6Ops.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha 6 OPS — Desktop Preview" Width="1366" Height="768" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#10120F" Foreground="#F0F0EB">
  <DockPanel Margin="32">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="ALPHA 6" FontWeight="Bold" FontSize="25" VerticalAlignment="Center" Margin="0,0,10,0"/><Border Background="{StaticResource Yellow}" Padding="9,4"><TextBlock Text="OPS" Foreground="#10120F" FontWeight="Black" FontSize="25"/></Border></StackPanel><TextBlock Text="ALPHA 6 DESIGNS" Foreground="#A9AD9F" FontSize="10" Margin="0,8,0,0"/></StackPanel>
      <TextBlock x:Name="VersionText" Grid.Column="1" Foreground="{StaticResource Yellow}" VerticalAlignment="Center" FontSize="11"/>
    </Grid>
    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Closing or minimizing keeps OPS in the tray. Use Exit to stop." Foreground="#ADB1A4" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Exit OPS" Click="Exit_Click" Margin="12,0,0,0" Padding="14,7"/></Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="You fly the airplane." FontSize="32" FontWeight="Bold"/>
        <TextBlock Text="We'll run the airline." FontSize="32" FontWeight="Bold" Foreground="{StaticResource Yellow}" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button x:Name="SimpleButton" Content="Simple" Click="Simple_Click"/><Button x:Name="AdvancedButton" Content="Advanced" Click="Advanced_Click"/><Button Content="Aircraft database" Click="Fleet_Click"/><Button Content="Minimize to tray" Click="Tray_Click"/></StackPanel>
        <Border Background="#1B1E17" BorderBrush="#3B4133" BorderThickness="1" Padding="18" Margin="0,0,0,14"><StackPanel>
          <Border x:Name="ConnectionBadge" Background="#30342C" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="11" Height="11" Fill="#A9AD9F" Margin="0,0,10,0"/><TextBlock x:Name="ConnectionBadgeText" Text="SIMULATOR DISCONNECTED" FontWeight="Bold" Foreground="White" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
          <WrapPanel><Button x:Name="ConnectButton" Content="Connect to MSFS 2024" Click="Connect_Click"/><Button Content="Export test log" Click="ExportLog_Click"/></WrapPanel>
          <TextBlock x:Name="ConnectionText" Text="Live monitor disconnected. Start MSFS 2024 and load an aircraft at a gate." TextWrapping="Wrap" Margin="0,12,0,0"/>
          <TextBlock x:Name="LiveText" Text="Live monitoring is separate from the sample rotation below." Foreground="{StaticResource Yellow}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock x:Name="LogStatusText" Text="Test logs are saved automatically when you connect." Foreground="#BFC5B4" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border Background="#1B1E17" BorderBrush="#3B4133" BorderThickness="1" Padding="24">
          <StackPanel>
            <TextBlock Text="ASSIGNED AIRCRAFT • N600A6" Foreground="{StaticResource Yellow}" FontSize="12"/>
            <TextBlock x:Name="RouteText" FontWeight="Bold" FontSize="30" Margin="0,10,0,4"/>
            <TextBlock x:Name="DepartureText" FontSize="16"/>
            <TextBlock x:Name="PhaseText" Foreground="{StaticResource Yellow}" Margin="0,16,0,4"/>
            <ProgressBar x:Name="ReplayProgress" Height="4" Maximum="12" Value="0" Foreground="{StaticResource Yellow}" Background="#3B4133" BorderThickness="0" Margin="0,8,0,12"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#C0C5B5" MinHeight="38"/>
            <WrapPanel Margin="0,16,0,0"><Button x:Name="ReplayButton" Content="Run flight replay" Background="{StaticResource Yellow}" Foreground="#10120F" FontWeight="Bold" Click="Replay_Click"/><Button x:Name="ResetButton" Content="Reset preview" Click="Reset_Click"/></WrapPanel>
            <TextBlock Text="Sample flight • 02 SEP 2026 • All times UTC • No live simulator connection" Foreground="#ADB1A4" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,22,0,0">
          <TextBlock Text="Today's aircraft rotation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <DataGrid x:Name="RotationGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#1B1E17" Foreground="#F0F0EB" BorderBrush="#3B4133" HorizontalGridLinesBrush="#3B4133" RowBackground="#1B1E17" AlternatingRowBackground="#23271D" RowHeight="42" ColumnHeaderHeight="36" SelectionMode="Single">
            <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#282D22"/><Setter Property="Foreground" Value="#F9D928"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.Resources>
            <DataGrid.Columns><DataGridTextColumn Header="Flight" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="*"/><DataGridTextColumn Header="Out UTC" Binding="{Binding Out}" Width="90"/><DataGridTextColumn Header="In UTC" Binding="{Binding In}" Width="90"/><DataGridTextColumn Header="Dep / arr delay" Binding="{Binding Delay}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/></DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="35-minute minimum turn. Schedule slack absorbs delay on later legs." Foreground="#ADB1A4" FontSize="12" Margin="0,10,0,16" TextWrapping="Wrap"/>
          <TextBlock Text="Flight milestones" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,8"/>
          <ItemsControl x:Name="EventsList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4" Foreground="#C0C5B5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
