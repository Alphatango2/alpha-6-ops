<Window x:Class="Alpha6Ops.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Alpha6Ops.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Sierra 4" Icon="Assets/Alpha6OPS.ico" Width="1536" Height="1024" MinWidth="640" MinHeight="480" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource S4.AppBackground}" Foreground="{StaticResource S4.TextPrimary}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="DispatchHeaderCard" TargetType="Button" BasedOn="{StaticResource OpsExit}">
      <Setter Property="Background" Value="#091219"/><Setter Property="BorderBrush" Value="#293A46"/>
    </Style>
    <Style x:Key="OpsCaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource S4.TextSecondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource S4.SurfaceElevated}" />
          <Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Opacity" Value="0.7" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="OpsCloseCaptionButton" TargetType="Button" BasedOn="{StaticResource OpsCaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource S4.Critical}" />
          <Setter Property="Foreground" Value="{StaticResource S4.TextPrimary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="{StaticResource S4.AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource S4.AppBackground}" BorderBrush="{StaticResource S4.Divider}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center">
          <Image Source="Assets/Sierra4/s4-mark.png" Width="18" Height="18" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource OpsCaptionButton}" Click="MinimizeWindow_Click" AutomationProperties.Name="Minimize Sierra 4">
            <Viewbox Width="12" Height="12">
              <Canvas Width="12" Height="12">
                <Path Data="M 1,9 L 11,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button Style="{StaticResource OpsCaptionButton}" Click="ToggleMaximizeWindow_Click" AutomationProperties.Name="Maximize or restore Sierra 4">
            <Grid Width="12" Height="12">
              <Rectangle x:Name="MaximizeIcon" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
              <Grid x:Name="RestoreIcon" Visibility="Collapsed">
                <Path Data="M 3,1 L 11,1 L 11,9 L 9,9 M 1,3 L 9,3 L 9,11 L 1,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Fill="{StaticResource S4.AppBackground}" />
              </Grid>
            </Grid>
          </Button>
          <Button Style="{StaticResource OpsCloseCaptionButton}" Click="CloseWindow_Click" AutomationProperties.Name="Close Sierra 4">
            <Viewbox Width="12" Height="12">
              <Canvas Width="12" Height="12">
                <Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="ShellComposition" Grid.Row="1">
      <local:SierraShell x:Name="Shell"/>

    <Grid x:Name="HeaderStatusGrid" Width="1020" MinHeight="108">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width=".95*"/>
        <ColumnDefinition Width="1.25*"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="ConnectionBadge" Style="{StaticResource OpsButton}" Background="#091219" BorderBrush="#293A46" Margin="0,0,10,0" Padding="10,8" Click="QuickConnect_Click" AutomationProperties.Name="Simulator connection" AutomationProperties.HelpText="Connect to MSFS 2024, or view connection controls when a session or replay is active.">
        <Button.ToolTip>
          <StackPanel MaxWidth="320">
            <TextBlock Text="{Binding Text, ElementName=ConnectionActionText}" Foreground="{StaticResource OpsYellow}" />
            <TextBlock Text="{Binding Text, ElementName=ConnectionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Button.ToolTip>
        <Grid x:Name="ConnectionCardContent" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="ConnectionDot" Width="13" Height="13" Fill="#80919D" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="ConnectionBadgeText" Text="DISCONNECTED" FontFamily="Bahnschrift SemiCondensed" FontSize="14" MaxWidth="110" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ConnectionSourceText" Text="MSFS 2024" Style="{StaticResource OpsCaption}" FontSize="12" TextAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="ConnectionActionText" FontSize="10" Foreground="{StaticResource OpsYellow}" TextAlignment="Center" Margin="0,4,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding SimulatorReadyAction, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled, ElementName=ConnectButton}" Value="False">
                      <Setter Property="Text" Value="VIEW CONTROLS" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Button>
      <Button x:Name="HeaderDispatchButton" Grid.Column="1" Style="{StaticResource DispatchHeaderCard}" Tag="Dispatch" Click="Module_Click" Margin="0,0,10,0" Padding="10,8" ToolTip="Open Dispatch">
        <StackPanel x:Name="DispatchCardContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="26" Margin="0,0,12,0" />
          <StackPanel>
            <TextBlock Text="DISPATCH" FontSize="14" TextAlignment="Center" />
            <TextBlock x:Name="DispatchSubtitleText" Text="FLIGHT DESK" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.72" FontSize="12" TextAlignment="Center" Margin="0,5,0,0" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Button x:Name="LocalWeatherButton" Grid.Column="2" Style="{StaticResource OpsButton}" Background="#091219" BorderBrush="#22333F" Click="LocalWeather_Click" Margin="0,0,10,0" Padding="10,8" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="WeatherCardContent" VerticalAlignment="Center">
          <TextBlock x:Name="WeatherLocationText" Text="LOCAL WEATHER" Foreground="#A5B3BE" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
          <StackPanel x:Name="WeatherReadingContent" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
            <local:WeatherConditionIcon x:Name="WeatherIcon" Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock x:Name="WeatherTemperatureText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="25" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="WeatherConditionText" Text="LOCATING…" Foreground="#9FB0BF" FontSize="11" Margin="0,3,0,0" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Button>
      <Border x:Name="HeaderClockPanel" Grid.Column="3" Style="{StaticResource OpsPanel}" Padding="10,8">
        <Grid x:Name="ClockCardContent" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="21" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel x:Name="LocalClockGroup" VerticalAlignment="Center">
            <TextBlock x:Name="LocalClockText" Text="00:00:00 LOCAL" FontFamily="Bahnschrift SemiCondensed" FontSize="22" TextAlignment="Center" />
            <TextBlock x:Name="LocalClockDateText" Style="{StaticResource OpsCaption}" FontSize="11" Margin="0,5,0,0" TextAlignment="Center" />
          </StackPanel>
          <Border x:Name="ClockDivider" Grid.Column="1" Width="1" Background="#293C49" />
          <StackPanel x:Name="ZuluClockGroup" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="ClockText" Text="00:00:00 Z" FontFamily="Bahnschrift SemiCondensed" FontSize="22" Foreground="{StaticResource OpsYellow}" TextAlignment="Center" />
            <TextBlock x:Name="ClockDateText" Style="{StaticResource OpsCaption}" FontSize="11" Margin="0,5,0,0" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>


        <Grid x:Name="LegacyWorkspaceContent">
          <ScrollViewer x:Name="LegacyViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
            <ScrollViewer.Resources><StaticResource x:Key="{x:Static SystemColors.ControlBrushKey}" ResourceKey="S4.AppBackground"/></ScrollViewer.Resources>
            <Grid x:Name="DashboardRoot" MinWidth="{StaticResource S4.LegacyMinimumWidth}" MinHeight="{StaticResource S4.LegacyMinimumHeight}" Width="{Binding ViewportWidth,ElementName=LegacyViewport}" Height="{Binding ViewportHeight,ElementName=LegacyViewport}">
    <local:FlightTrackingWorkspace x:Name="FlightTrackingView"  Visibility="Collapsed" Margin="0,0,1,8" />
    <local:PilotLogbookWorkspace x:Name="PilotLogbookView"  Visibility="Collapsed" Margin="0,0,1,8" />
    <local:DispatchWorkspace x:Name="DispatchView"  Visibility="Collapsed" Margin="0,0,1,8" />
            </Grid>
          </ScrollViewer>
          <local:OperationsWorkspace x:Name="OperationsView"/>
          <local:SierraStatePanel x:Name="ShellUnavailable" Style="{StaticResource S4.State}" Kind="Unavailable" Heading="Airports" Message="An airport workspace is not available yet. Your flight's departure and arrival details remain available in Dispatch and Flights." Visibility="Collapsed" VerticalAlignment="Top"/>
        </Grid>

    </Grid>
    <Grid x:Name="ToolsOverlay" Grid.Row="1" Visibility="Collapsed" Background="#AC000000" Panel.ZIndex="10">
      <Border Width="568" MaxWidth="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" Background="#0A131B" BorderBrush="#3E5262" BorderThickness="1,0,0,0">
        <DockPanel Margin="24">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="YOUR FLIGHT DECK" Style="{StaticResource OpsTitle}" FontSize="25" />
              <TextBlock Text="Assignment, simulator connection &amp; live flight tracking" Style="{StaticResource OpsCaption}" Margin="0,7,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Click="CloseTools_Click" Style="{StaticResource OpsButton}" AutomationProperties.Name="Close flight tools" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
        <Border x:Name="AdvancedPanel" Style="{StaticResource OpsPanel}" Visibility="Collapsed" Margin="0,12,0,0" Padding="17">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="ROTATION DETAIL &amp; FLIGHT MILESTONES" Style="{StaticResource OpsTitle}" />
              <TextBlock x:Name="PhaseText" Grid.Column="1" Text="AT GATE" Foreground="{StaticResource OpsYellow}" FontFamily="Bahnschrift SemiCondensed" />
            </Grid>
            <DataGrid x:Name="RotationGrid" Style="{StaticResource OpsGrid}" Margin="0,13,0,8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FLIGHT" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="ROUTE" Binding="{Binding Route}" Width="*" />
                <DataGridTextColumn Header="OUT UTC" Binding="{Binding Out}" Width="100" />
                <DataGridTextColumn Header="IN UTC" Binding="{Binding In}" Width="100" />
                <DataGridTextColumn Header="DEP / ARR DELAY" Binding="{Binding Delay}" Width="140" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
            <ItemsControl x:Name="EventsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#B9CBD8" FontSize="12" Margin="0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

              <TextBlock Text="PILOT NAME" Style="{StaticResource OpsCaption}" />
              <TextBox x:Name="PilotNameBox" Style="{StaticResource OpsInput}" Margin="0,7,0,17" TextChanged="PilotName_Changed" AutomationProperties.Name="Pilot name" />
              <TextBlock Text="FLIGHT ASSIGNMENT" Style="{StaticResource OpsTitle}" />
              <TextBlock x:Name="RouteText" FontSize="23" Margin="0,8,0,4" />
              <TextBlock x:Name="DepartureText" Foreground="#A9BDCC" TextWrapping="Wrap" />
              <WrapPanel Margin="0,12,0,20">
                <Button Content="SET ACTIVE FLIGHT / IMPORT SIMBRIEF" Style="{StaticResource OpsButton}" Click="SetFlight_Click" Margin="0,0,10,0" />
                <Button x:Name="ClearFlightButton" Content="CLEAR ACTIVE FLIGHT" Style="{StaticResource OpsButton}" Click="ClearFlight_Click" IsEnabled="False" />
              </WrapPanel>
              <UniformGrid Columns="3" Margin="0,0,0,18">
                <StackPanel>
                  <TextBlock Text="DEPARTED" Style="{StaticResource OpsCaption}" />
                  <TextBlock x:Name="DepartedValueText" Text="—" FontSize="19" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="EST. ARRIVAL" Style="{StaticResource OpsCaption}" />
                  <TextBlock x:Name="ArrivalValueText" Text="—" FontSize="19" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="ELAPSED" Style="{StaticResource OpsCaption}" />
                  <TextBlock x:Name="ElapsedValueText" Text="—" FontSize="19" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="SIMULATOR" Style="{StaticResource OpsTitle}" />
              <WrapPanel Margin="0,10,0,8">
                <Button x:Name="ConnectButton" Content="LAUNCH / CONNECT TO MSFS 2024" Style="{StaticResource OpsPrimary}" Click="Connect_Click" Margin="0,0,10,8" />
                <Button x:Name="DisconnectButton" Content="DISCONNECT" Style="{StaticResource OpsButton}" IsEnabled="False" Click="Disconnect_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock x:Name="ConnectionText" Text="Launch or connect to MSFS 2024 here, then load a flight." TextWrapping="Wrap" Foreground="#B6C8D6" FontSize="12" />
              <TextBlock x:Name="LiveText" Text="Live telemetry appears after connecting." Foreground="#D9C956" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,10" />
              <WrapPanel>
                <Button x:Name="LiveTimelineButton" Content="LIVE TIMELINE" Style="{StaticResource OpsButton}" IsEnabled="False" Click="LiveTimeline_Click" Margin="0,0,8,8" />
                <Button x:Name="LiveDebriefButton" Content="LIVE DEBRIEF" Style="{StaticResource OpsButton}" IsEnabled="False" Click="LiveDebrief_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <Rectangle Height="1" Fill="#2B3E4B" Margin="0,13,0,20" />
              <TextBlock Text="FLIGHT DISPLAY" Style="{StaticResource OpsTitle}" />
              <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#ADC0CE" FontSize="12" Margin="0,4,0,16" />
              <WrapPanel>
                <Button x:Name="SimpleButton" Content="DASHBOARD" Style="{StaticResource OpsButton}" Click="Simple_Click" Margin="0,0,8,8" />
                <Button x:Name="AdvancedButton" Content="SHOW ROTATION DETAIL" Style="{StaticResource OpsButton}" Click="Advanced_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <Rectangle Height="55" HorizontalAlignment="Left" Width="190" Margin="0,20,0,5">
                <Rectangle.Fill>
                  <ImageBrush ImageSource="Assets/Dashboard/alpha6-designs-logo.png" Viewbox="0.01,0.12,0.98,0.77" Stretch="Uniform" />
                </Rectangle.Fill>
              </Rectangle>
              <!-- Replay remains an internal deterministic test fixture, not a pilot-facing tool. -->
              <Grid Visibility="Collapsed">
                <ComboBox x:Name="FixtureCombo" />
                <Button x:Name="ReplayButton" />
                <Button x:Name="ResetButton" />
                <TextBlock x:Name="LogStatusText" Text="Test logs save automatically when you connect." />
                <TextBlock x:Name="ProgramHealthText" Text="PROGRAM MONITOR STARTING" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
