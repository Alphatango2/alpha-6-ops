          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Settings" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
