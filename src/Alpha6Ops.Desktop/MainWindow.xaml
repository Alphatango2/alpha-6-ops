      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C7D2DA" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#25323B" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Opacity" Value="0.7" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="OpsCloseCaptionButton" TargetType="Button" BasedOn="{StaticResource OpsCaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="AlertTemplate">
      <Button Style="{StaticResource OpsLink}" Padding="13,10" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="Alert_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="27" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Icon}" Foreground="{Binding Color}" FontFamily="Segoe MDL2 Assets" FontSize="19" />
          <StackPanel Grid.Column="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Age}" Style="{StaticResource OpsCaption}" FontSize="9" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Summary}" Foreground="#B2BEC9" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="MessageTemplate">
      <Button Style="{StaticResource OpsLink}" Foreground="#EEF2F5" Padding="12,8" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="Message_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Color}" FontSize="16" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" Foreground="#91A4B4" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding ReadLabel}" Foreground="#92A2B0" FontSize="9" Margin="6,2,0,0" />
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>
