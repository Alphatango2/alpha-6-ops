                    <Path Data="M 0,18 L 12,16 7,1 13,1 24,15 37,15 Q 48,17 37,20 L 24,20 13,34 7,34 12,21 0,20 Z" Fill="{StaticResource OpsYellow}" Width="44" Height="35" Stretch="Uniform" Margin="2,-4,2,0" />
                    <Rectangle Height="2" Width="36" Fill="#7F919E" />
                    <TextBlock Text="›" FontSize="30" Foreground="#9BABB9" Margin="-2,-13,0,0" />
                  </StackPanel>
