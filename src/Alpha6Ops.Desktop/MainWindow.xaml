              <TextBlock Text="NETWORK" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Weather" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="☀" FontFamily="Segoe UI Symbol" FontSize="21" Width="43" />
              <TextBlock Text="WEATHER" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Dispatch" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="DISPATCH" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="OCC" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="OCC" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Reports" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="REPORTS" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Settings" Click="Module_Click">
