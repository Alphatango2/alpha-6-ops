    </DockPanel>
    <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,1,8">
      <StackPanel>
        <Grid Height="353">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.7*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource OpsPanel}" ClipToBounds="True">
            <Grid>
              <Image Source="Assets/Dashboard/hero.png" Stretch="UniformToFill" />
