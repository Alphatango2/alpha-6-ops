                  <TextBlock x:Name="HeroTimingText" Text="Scheduled 10:00Z" FontSize="13" Margin="13,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="4" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DEPARTURE" Style="{StaticResource OpsCaption}" />
                    <TextBlock x:Name="HeroDepartureText" FontFamily="Bahnschrift SemiCondensed" FontSize="19" Margin="0,3,0,0" />
                    <TextBlock Text="UTC" Style="{StaticResource OpsCaption}" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="GATE" Style="{StaticResource OpsCaption}" />
                    <TextBlock x:Name="HeroDepartureGateText" Text="—" FontSize="19" Margin="0,3,0,0" ToolTip="No gate assignment has been supplied." />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="ARRIVAL" Style="{StaticResource OpsCaption}" />
                    <TextBlock x:Name="HeroArrivalText" FontFamily="Bahnschrift SemiCondensed" FontSize="19" Margin="0,3,0,0" />
                    <TextBlock Text="UTC" Style="{StaticResource OpsCaption}" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="3">
                    <TextBlock Text="GATE" Style="{StaticResource OpsCaption}" />
                    <TextBlock x:Name="HeroArrivalGateText" Text="—" FontSize="19" Margin="0,3,0,0" ToolTip="No gate assignment has been supplied." />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="AIRCRAFT" Style="{StaticResource OpsCaption}" />
                    <TextBlock x:Name="AircraftText" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeroAircraftTypeText" Text="SAMPLE ASSIGNMENT" Style="{StaticResource OpsCaption}" FontSize="10" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="HeroFlightDetailsButton" Content="VIEW FLIGHT DETAILS    →" Style="{StaticResource OpsPrimary}" Click="FlightDetails_Click" Padding="17,9" />
                  <Button x:Name="HeroFlightDeckButton" Content="VIEW FLIGHT DECK" Style="{StaticResource OpsButton}" Click="FlightDeck_Click" Margin="12,0,0,0" Padding="22,9" />
                </StackPanel>
                <ProgressBar x:Name="ReplayProgress" Grid.Row="6" Maximum="100" Height="3" VerticalAlignment="Bottom" Foreground="{StaticResource OpsYellow}" Background="#35414A" BorderThickness="0" />
              </Grid>
            </Grid>
          </Border>
          <Border x:Name="AlertsPanel" Grid.Column="2" Style="{StaticResource OpsPanel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="13,8,10,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ALERTS" Style="{StaticResource OpsTitle}" />
                <Button x:Name="ViewAlertsButton" Grid.Column="1" Content="VIEW ALL (7)" Style="{StaticResource OpsLink}" Click="AllAlerts_Click" />
              </Grid>
              <TextBlock DockPanel.Dock="Bottom" Text="DEMO SCENARIO • NOT LIVE ADVISORIES" FontSize="8" Foreground="#8198AA" Margin="14,3,8,8" />
              <ItemsControl x:Name="AlertsItems" ItemTemplate="{StaticResource AlertTemplate}" />
            </DockPanel>
          </Border>
        </Grid>
        <Grid x:Name="ModulesMapLayout" Margin="0,12,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.85*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <ItemsControl x:Name="ModuleTiles">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <local:DashboardTilePanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource OpsTile}" Margin="0" VerticalContentAlignment="Stretch" Tag="{Binding Name}" Click="Module_Click" ToolTip="{Binding Description}">
                  <Grid MinHeight="113" ClipToBounds="True">
                    <Grid.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Grid.Background>
                    <Rectangle>
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#00000000" />
                          <GradientStop Color="#5A03080C" Offset=".4" />
                          <GradientStop Color="#FA03080C" Offset=".88" />
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>
                    <Grid VerticalAlignment="Bottom" Margin="12,0,10,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource OpsTitle}" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Foreground="#B6C5D1" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource OpsYellow}" FontSize="22" VerticalAlignment="Bottom" />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="NetworkPanel" Grid.Column="1" Style="{StaticResource OpsPanel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="13,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="NETWORK MAP" Style="{StaticResource OpsTitle}" />
                <Button x:Name="OpenTrackerButton" Grid.Column="1" Content="OPEN TRACKER  →" Style="{StaticResource OpsLink}" Foreground="#FFDA00" FontSize="10" Click="OpenTracker_Click" ToolTip="Open the full Flight Tracking workspace" />
              </Grid>
              <local:NetworkMap x:Name="RouteMap" />
            </DockPanel>
          </Border>
        </Grid>
        <Grid x:Name="SummaryLayout">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.65*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="OperationsPanel" MinHeight="225" Style="{StaticResource OpsPanel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="13,8,9,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="TODAY'S OPERATIONS" Style="{StaticResource OpsTitle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="MyFlightsTab" Content="MY FLIGHTS" Tag="all" Style="{StaticResource OpsLink}" Foreground="{StaticResource OpsYellow}" Click="FlightsTab_Click" />
                  <Button x:Name="AssignedFlightsTab" Content="ASSIGNED" Tag="assigned" Style="{StaticResource OpsLink}" Foreground="#A7B7C5" Click="FlightsTab_Click" />
                  <Button x:Name="WatchlistTab" Content="WATCHLIST (0)" Tag="watchlist" Style="{StaticResource OpsLink}" Foreground="#A7B7C5" Click="FlightsTab_Click" />
                </StackPanel>
              </Grid>
              <Grid DockPanel.Dock="Bottom" Margin="12,4,9,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OperationsFootnote" Text="02 SEP 2026  •  ALL TIMES UTC" Style="{StaticResource OpsCaption}" FontSize="9" />
                <Button Grid.Column="1" x:Name="WatchFlightButton" Content="☆  WATCH SELECTED" Style="{StaticResource OpsLink}" Foreground="{StaticResource OpsYellow}" Click="WatchFlight_Click" />
              </Grid>
              <Grid>
                <DataGrid x:Name="DashboardFlightsGrid" Style="{StaticResource OpsGrid}" Margin="7,0" MouseDoubleClick="FlightRow_DoubleClick" SelectionChanged="FlightSelection_Changed">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="FLIGHT" Binding="{Binding Id}" Width="62" />
                    <DataGridTextColumn Header="ROUTE" Binding="{Binding Route}" Width="*" />
                    <DataGridTextColumn Header="OUT" Binding="{Binding Out}" Width="48" />
                    <DataGridTextColumn Header="IN" Binding="{Binding In}" Width="48" />
                    <DataGridTemplateColumn Header="STATUS" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border Background="{Binding StatusBackground}" Padding="7,4" CornerRadius="3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyFlightsText" Visibility="Collapsed" Text="Select a flight in My flights, then add it to your watchlist." TextWrapping="Wrap" Foreground="#A3B5C5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22" />
              </Grid>
            </DockPanel>
          </Border>
          <Border x:Name="FleetPanel" MinHeight="225" Grid.Column="2" Style="{StaticResource OpsPanel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="13,8,10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="FLEET REFERENCE" Style="{StaticResource OpsTitle}" />
                <Button Grid.Column="1" Content="VIEW FLEET" Click="Fleet_Click" Style="{StaticResource OpsLink}" />
              </Grid>
              <TextBlock DockPanel.Dock="Bottom" Text="AIRFLEETS SNAPSHOT  ·  02 SEP 2026" FontSize="8" Foreground="#7F96A8" Margin="13,0,5,11" />
              <Grid Margin="9,7,9,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Viewbox Stretch="Uniform" MaxWidth="147">
                  <Grid Width="150" Height="150">
                    <Canvas x:Name="FleetRing" Width="150" Height="150" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock x:Name="FleetCountText" Text="1,006" FontFamily="Bahnschrift SemiCondensed" FontSize="29" HorizontalAlignment="Center" />
                      <TextBlock Text="AIRCRAFT" Style="{StaticResource OpsCaption}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                  <TextBlock x:Name="FleetActiveText" Text="■  ACTIVE        999" Foreground="#71D255" FontFamily="Bahnschrift SemiCondensed" FontSize="12" />
                  <TextBlock x:Name="FleetParkedText" Text="■  PARKED           7" Foreground="#FFD600" FontFamily="Bahnschrift SemiCondensed" FontSize="12" Margin="0,15,0,0" />
                  <TextBlock x:Name="FleetFamiliesText" Text="10 aircraft families" Style="{StaticResource OpsCaption}" FontSize="10" Margin="0,20,0,0" />
                  <TextBlock Text="Reference status only" Style="{StaticResource OpsCaption}" FontSize="9" Margin="0,5,0,0" />
                </StackPanel>
              </Grid>
            </DockPanel>
          </Border>
          <Border x:Name="MessagesPanel" MinHeight="225" Grid.Column="4" Style="{StaticResource OpsPanel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="13,8,10,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="COMPANY MESSAGES" Style="{StaticResource OpsTitle}" />
                <Button Grid.Column="1" Content="VIEW ALL" Style="{StaticResource OpsLink}" Tag="Messages" Click="Module_Click" />
              </Grid>
              <ItemsControl x:Name="MessagesItems" ItemTemplate="{StaticResource MessageTemplate}" />
            </DockPanel>
          </Border>
        </Grid>
        <Border x:Name="AdvancedPanel" Style="{StaticResource OpsPanel}" Visibility="Collapsed" Margin="0,12,0,0" Padding="17">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="ROTATION DETAIL &amp; FLIGHT MILESTONES" Style="{StaticResource OpsTitle}" />
              <TextBlock x:Name="PhaseText" Grid.Column="1" Text="AT GATE" Foreground="{StaticResource OpsYellow}" FontFamily="Bahnschrift SemiCondensed" />
            </Grid>
            <DataGrid x:Name="RotationGrid" Style="{StaticResource OpsGrid}" Margin="0,13,0,8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FLIGHT" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="ROUTE" Binding="{Binding Route}" Width="*" />
                <DataGridTextColumn Header="OUT UTC" Binding="{Binding Out}" Width="100" />
                <DataGridTextColumn Header="IN UTC" Binding="{Binding In}" Width="100" />
                <DataGridTextColumn Header="DEP / ARR DELAY" Binding="{Binding Delay}" Width="140" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
            <ItemsControl x:Name="EventsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#B9CBD8" FontSize="12" Margin="0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </local:DashboardBodyPanel>
    </ScrollViewer>
    <local:FlightTrackingWorkspace x:Name="FlightTrackingView" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" Margin="0,0,1,8" />
    <Grid x:Name="DashboardFooter" Grid.Row="2" Grid.ColumnSpan="3" Margin="220,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterBrand" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
        <Run Text="ALPHA 6" Foreground="{StaticResource OpsYellow}" /><Run Text=" OPS  •  OPERATIONS CONTROL CENTER" Foreground="#9DB0BE" />
      </TextBlock>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="VersionText" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" Foreground="#9DB0BE" Margin="0,0,16,0" VerticalAlignment="Center" />
        <Button x:Name="ExitOpsButton" Content="EXIT OPS" Style="{StaticResource OpsExit}" Padding="16,8" MinWidth="88" MinHeight="34" Click="Exit_Click" AutomationProperties.Name="Exit Alpha 6 OPS" ToolTip="Close Alpha 6 OPS" />
      </StackPanel>
    </Grid>
    <Grid x:Name="ToolsOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#AC000000" Panel.ZIndex="10">
      <Border Width="568" HorizontalAlignment="Right" Background="#0A131B" BorderBrush="#3E5262" BorderThickness="1,0,0,0">
        <DockPanel Margin="24">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="YOUR FLIGHT DECK" Style="{StaticResource OpsTitle}" FontSize="25" />
              <TextBlock Text="Assignment, simulator connection &amp; live flight tracking" Style="{StaticResource OpsCaption}" Margin="0,7,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Click="CloseTools_Click" Style="{StaticResource OpsButton}" AutomationProperties.Name="Close flight tools" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="PILOT NAME" Style="{StaticResource OpsCaption}" />
              <TextBox x:Name="PilotNameBox" Style="{StaticResource OpsInput}" Margin="0,7,0,17" TextChanged="PilotName_Changed" AutomationProperties.Name="Pilot name" />
              <TextBlock Text="FLIGHT ASSIGNMENT" Style="{StaticResource OpsTitle}" />
              <TextBlock x:Name="RouteText" FontSize="23" Margin="0,8,0,4" />
              <TextBlock x:Name="DepartureText" Foreground="#A9BDCC" TextWrapping="Wrap" />
              <Button Content="SET ACTIVE FLIGHT / IMPORT SIMBRIEF" Style="{StaticResource OpsButton}" Click="SetFlight_Click" Margin="0,12,0,20" />
              <UniformGrid Columns="3" Margin="0,0,0,18">
                <StackPanel>
                  <TextBlock Text="DEPARTED" Style="{StaticResource OpsCaption}" />
                  <TextBlock x:Name="DepartedValueText" Text="—" FontSize="19" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="EST. ARRIVAL" Style="{StaticResource OpsCaption}" />
                  <TextBlock x:Name="ArrivalValueText" Text="—" FontSize="19" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="ELAPSED" Style="{StaticResource OpsCaption}" />
                  <TextBlock x:Name="ElapsedValueText" Text="—" FontSize="19" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="SIMULATOR" Style="{StaticResource OpsTitle}" />
              <WrapPanel Margin="0,10,0,8">
                <Button x:Name="ConnectButton" Content="CONNECT TO MSFS 2024" Style="{StaticResource OpsPrimary}" Click="Connect_Click" Margin="0,0,10,8" />
                <Button x:Name="ConnectFlightLabButton" Content="CONNECT TO FLIGHT LAB" Style="{StaticResource OpsButton}" Click="ConnectFlightLab_Click" Margin="0,0,10,8" ToolTip="Connect to the local Alpha 6 Flight Lab test program" />
                <Button x:Name="DisconnectButton" Content="DISCONNECT" Style="{StaticResource OpsButton}" IsEnabled="False" Click="Disconnect_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock x:Name="ConnectionText" Text="Start MSFS 2024 and load an aircraft at a gate." TextWrapping="Wrap" Foreground="#B6C8D6" FontSize="12" />
              <TextBlock x:Name="LiveText" Text="Live telemetry appears after connecting." Foreground="#D9C956" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,10" />
              <WrapPanel>
                <Button x:Name="LiveTimelineButton" Content="LIVE TIMELINE" Style="{StaticResource OpsButton}" IsEnabled="False" Click="LiveTimeline_Click" Margin="0,0,8,8" />
                <Button x:Name="LiveDebriefButton" Content="LIVE DEBRIEF" Style="{StaticResource OpsButton}" IsEnabled="False" Click="LiveDebrief_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <Rectangle Height="1" Fill="#2B3E4B" Margin="0,13,0,20" />
              <TextBlock Text="FLIGHT DISPLAY" Style="{StaticResource OpsTitle}" />
              <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#ADC0CE" FontSize="12" Margin="0,4,0,16" />
              <WrapPanel>
                <Button x:Name="SimpleButton" Content="DASHBOARD" Style="{StaticResource OpsButton}" Click="Simple_Click" Margin="0,0,8,8" />
                <Button x:Name="AdvancedButton" Content="SHOW ROTATION DETAIL" Style="{StaticResource OpsButton}" Click="Advanced_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <Rectangle Height="55" HorizontalAlignment="Left" Width="190" Margin="0,20,0,5">
                <Rectangle.Fill>
                  <ImageBrush ImageSource="Assets/Dashboard/alpha6-designs-logo.png" Viewbox="0.01,0.12,0.98,0.77" Stretch="Uniform" />
                </Rectangle.Fill>
              </Rectangle>
              <!-- Replay remains an internal deterministic test fixture, not a pilot-facing tool. -->
              <Grid Visibility="Collapsed">
                <ComboBox x:Name="FixtureCombo" />
                <Button x:Name="ReplayButton" />
                <Button x:Name="ResetButton" />
                <TextBlock x:Name="LogStatusText" Text="Test logs save automatically when you connect." />
                <TextBlock x:Name="ProgramHealthText" Text="PROGRAM MONITOR STARTING" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    </Grid>
    </Viewbox>
  </Grid>
</Window>
