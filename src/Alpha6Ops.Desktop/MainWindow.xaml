        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Button x:Name="ConnectionBadge" Style="{StaticResource OpsButton}" Background="#091219" BorderBrush="#293A46" Margin="0,0,10,0" Padding="10,8" Click="QuickConnect_Click" AutomationProperties.Name="Simulator connection" AutomationProperties.HelpText="Connect to MSFS 2024, or view connection controls when a session or replay is active.">
        <Button.ToolTip>
          <StackPanel MaxWidth="320">
            <TextBlock Text="{Binding Text, ElementName=ConnectionActionText}" Foreground="{StaticResource OpsYellow}" />
            <TextBlock Text="{Binding Text, ElementName=ConnectionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Button.ToolTip>
        <Grid x:Name="ConnectionCardContent" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="ConnectionDot" Width="13" Height="13" Fill="#80919D" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="ConnectionBadgeText" Text="DISCONNECTED" FontFamily="Bahnschrift SemiCondensed" FontSize="14" MaxWidth="110" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="MSFS 2024" Style="{StaticResource OpsCaption}" FontSize="12" TextAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="ConnectionActionText" FontSize="10" Foreground="{StaticResource OpsYellow}" TextAlignment="Center" Margin="0,4,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="CLICK TO CONNECT" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled, ElementName=ConnectButton}" Value="False">
                      <Setter Property="Text" Value="VIEW CONTROLS" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Button>
      <Button x:Name="HeaderDispatchButton" Grid.Column="1" Style="{StaticResource OpsButton}" Background="#091219" BorderBrush="#22333F" Tag="Dispatch" Click="Module_Click" Margin="0,0,10,0" Padding="10,8" ToolTip="Open the dispatch desk">
        <StackPanel x:Name="DispatchCardContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource OpsYellow}" FontSize="26" Margin="0,0,12,0" />
          <StackPanel>
            <TextBlock Text="DISPATCH" FontSize="14" TextAlignment="Center" />
            <TextBlock Text="LOCAL DESK" Foreground="#A5B3BE" FontSize="12" TextAlignment="Center" Margin="0,5,0,0" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Button x:Name="LocalWeatherButton" Grid.Column="2" Style="{StaticResource OpsButton}" Background="#091219" BorderBrush="#22333F" Click="LocalWeather_Click" Margin="0,0,10,0" Padding="10,8" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="WeatherCardContent" VerticalAlignment="Center">
          <TextBlock x:Name="WeatherLocationText" Text="LOCAL WEATHER" Foreground="#A5B3BE" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
          <StackPanel x:Name="WeatherReadingContent" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
            <local:WeatherConditionIcon x:Name="WeatherIcon" Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock x:Name="WeatherTemperatureText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="25" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="WeatherConditionText" Text="LOCATING…" Foreground="#9FB0BF" FontSize="11" Margin="0,3,0,0" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Button>
      <Border x:Name="HeaderClockPanel" Grid.Column="3" Style="{StaticResource OpsPanel}" Padding="10,8">
        <Grid x:Name="ClockCardContent" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="21" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel x:Name="LocalClockGroup" VerticalAlignment="Center">
            <TextBlock x:Name="LocalClockText" Text="00:00:00 LOCAL" FontFamily="Bahnschrift SemiCondensed" FontSize="22" TextAlignment="Center" />
            <TextBlock x:Name="LocalClockDateText" Style="{StaticResource OpsCaption}" FontSize="11" Margin="0,5,0,0" TextAlignment="Center" />
          </StackPanel>
          <Border x:Name="ClockDivider" Grid.Column="1" Width="1" Background="#293C49" />
          <StackPanel x:Name="ZuluClockGroup" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="ClockText" Text="00:00:00 Z" FontFamily="Bahnschrift SemiCondensed" FontSize="22" Foreground="{StaticResource OpsYellow}" TextAlignment="Center" />
            <TextBlock x:Name="ClockDateText" Style="{StaticResource OpsCaption}" FontSize="11" Margin="0,5,0,0" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <StackPanel x:Name="NavigationProfile" DockPanel.Dock="Bottom" Margin="0,23,0,-6">
        <Border Style="{StaticResource OpsPanel}" Padding="14,13">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="40" Height="40" CornerRadius="20" Background="#24313B" BorderBrush="#526574" BorderThickness="1">
                <TextBlock x:Name="PilotInitialsText" Text="A6" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource OpsYellow}" />
              </Border>
              <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="PilotDisplayText" Text="Your flight deck" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Alpha 6 Virtual" Style="{StaticResource OpsCaption}" FontSize="10" Margin="0,4,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="●  LOCAL SESSION" Foreground="#6BCB65" FontSize="10" Margin="51,8,0,0" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="NavigationTagline" Text="YOU FLY THE AIRPLANE.&#xA;WE RUN THE AIRLINE." FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" Foreground="#CBD6E0" LineHeight="19" TextWrapping="NoWrap" Margin="15,19,0,0" />
        <Rectangle Fill="{StaticResource OpsYellow}" Height="2" Width="27" HorizontalAlignment="Left" Margin="15,12,0,0" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" PanningMode="None">
        <StackPanel x:Name="NavigationButtons">
          <Button x:Name="DashboardNavButton" Style="{StaticResource OpsNav}" Click="Dashboard_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="22" Width="43" />
              <TextBlock Text="DASHBOARD" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="FlightTrackingNavButton" Style="{StaticResource OpsNav}" Tag="FlightTracking" Click="Module_Click" AutomationProperties.Name="FLIGHT TRACKING">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="FLIGHT TRACKING" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Operations" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="OPERATIONS" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Aircraft" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="AIRCRAFT" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Maintenance" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="MAINTENANCE" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Crews" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="24" Height="24" Margin="0,0,19,0">
                <Canvas Width="24" Height="24">
                  <Path Data="M 7,6 L 17,6 L 15,3.5 L 9,3.5 Z M 7,7.8 L 17,7.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                  <Ellipse Canvas.Left="8.5" Canvas.Top="7" Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                  <Path Data="M 4.5,21 C 5,16.3 7.7,14.4 12,14.4 C 16.3,14.4 19,16.3 19.5,21 M 9.3,15.1 L 12,18 L 14.7,15.1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="CREWS" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Passengers" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="PASSENGERS" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Network" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="NETWORK" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Weather" Click="Module_Click">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="24" Height="24" Margin="0,0,19,0">
                <Canvas Width="24" Height="24">
                  <Ellipse Canvas.Left="4.5" Canvas.Top="3.5" Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" />
                  <Path Data="M 8,1 L 8,2 M 8,12 L 8,14 M 1,7 L 3,7 M 13,7 L 15,7 M 3,2 L 4.3,3.3 M 11.7,10.7 L 13,12 M 13,2 L 11.7,3.3 M 4.3,10.7 L 3,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Path Data="M 5,20 L 18.5,20 C 21,20 22.5,18.4 22.5,16.3 C 22.5,14.2 20.8,12.6 18.7,12.6 C 18.1,12.6 17.5,12.7 17,13 C 16.2,10.7 14.3,9.5 12,9.5 C 9.2,9.5 7,11.5 6.7,14.2 C 6.2,14 5.7,13.9 5.1,13.9 C 3.2,13.9 1.7,15.2 1.7,17 C 1.7,18.7 3.1,20 5,20 Z" Fill="#04090D" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeLineJoin="Round" />
                </Canvas>
