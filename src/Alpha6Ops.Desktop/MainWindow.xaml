              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="43" />
              <TextBlock Text="PASSENGERS" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpsNav}" Tag="Network" Click="Module_Click">
