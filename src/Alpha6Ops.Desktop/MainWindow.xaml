                    <TextBlock x:Name="DestinationCodeText" Text="DTW" FontFamily="Bahnschrift SemiCondensed" FontSize="51" FontWeight="Bold" />
                    <TextBlock x:Name="DestinationCityText" Text="DETROIT" FontFamily="Bahnschrift SemiCondensed" FontSize="12" />
