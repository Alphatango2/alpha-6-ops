    <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" PanningMode="None" Padding="0,0,1,8">
      <local:DashboardBodyPanel x:Name="DashboardBody" ViewportHeight="{Binding ViewportHeight, ElementName=DashboardScroll}">
