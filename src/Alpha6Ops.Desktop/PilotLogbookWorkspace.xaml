<UserControl x:Class="Alpha6Ops.Desktop.PilotLogbookWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#03090D" Foreground="#F2F6FA">
  <Grid Margin="0,0,20,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="PILOT LOGBOOK" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="YOUR RECORDED ALPHA 6 OPS FLIGHTS" Style="{StaticResource OpsCaption}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
      <Button Grid.Column="1" Content="BACK TO DASHBOARD" Style="{StaticResource OpsButton}" Padding="16,9" VerticalAlignment="Center" Click="Back_Click"/>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource OpsPanel}" Padding="18,14">
      <UniformGrid Columns="3">
        <StackPanel><TextBlock Text="RECORDED FLIGHTS" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="TotalText" Text="0" FontSize="21" Margin="0,6,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="COMPLETED" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="CompletedText" Text="0" FontSize="21" Foreground="#75D88A" Margin="0,6,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="IN PROGRESS / INTERRUPTED" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="OpenText" Text="0" FontSize="21" Foreground="{StaticResource OpsYellow}" Margin="0,6,0,0"/></StackPanel>
      </UniformGrid>
    </Border>
    <Border Grid.Row="4" Style="{StaticResource OpsPanel}" Padding="0">
      <Grid>
        <DataGrid x:Name="FlightsGrid" Style="{StaticResource OpsGrid}" Margin="1" MinColumnWidth="90" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="CALLSIGN" Binding="{Binding Callsign}" Width="150"/>
            <DataGridTextColumn Header="DEPARTURE" Binding="{Binding Departure}" Width="130"/>
            <DataGridTextColumn Header="ARRIVAL" Binding="{Binding Arrival}" Width="130"/>
            <DataGridTextColumn Header="AIRCRAFT" Binding="{Binding Aircraft}" Width="220"/>
            <DataGridTextColumn Header="DATE / STARTED UTC" Binding="{Binding Date}" Width="*"/>
            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="150"/>
            <DataGridTemplateColumn Header="STATUS" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="3" Padding="7,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="✈" Foreground="{StaticResource OpsYellow}" FontSize="36" HorizontalAlignment="Center"/>
          <TextBlock Text="NO FLIGHTS RECORDED YET" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock Text="Completed and interrupted flight sessions will appear here." Style="{StaticResource OpsCaption}" FontSize="12" Margin="0,7,0,0"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#FF9690" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" TextAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
