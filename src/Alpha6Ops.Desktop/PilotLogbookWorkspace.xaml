<UserControl x:Class="Alpha6Ops.Desktop.PilotLogbookWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#03090D" Foreground="#F2F6FA">
  <Grid Margin="0,0,20,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="PILOT LOGBOOK" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="YOUR COMPLETE FLIGHT HISTORY — IMPORTED AND RECORDED BY ALPHA 6 OPS" Style="{StaticResource OpsCaption}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
      <Button Grid.Column="1" Content="BACK TO DASHBOARD" Style="{StaticResource OpsExit}" Padding="16,9" VerticalAlignment="Center" Click="Back_Click"/>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource OpsPanel}" Padding="18,13">
      <UniformGrid Columns="4">
        <StackPanel><TextBlock Text="TOTAL FLIGHTS" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="TotalText" Text="0" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="TOTAL FLIGHT TIME" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="HoursText" Text="0 HOURS" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource OpsYellow}" Margin="0,5,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="COMPLETED / ACCEPTED" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="CompletedText" Text="0" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="SemiBold" Foreground="#75D88A" Margin="0,5,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="IN PROGRESS / INTERRUPTED" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="OpenText" Text="0" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="SemiBold" Foreground="#FFDA00" Margin="0,5,0,0"/></StackPanel>
      </UniformGrid>
    </Border>
    <Border Grid.Row="4" Style="{StaticResource OpsPanel}" Padding="14,11">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="SEARCH FLIGHTS" Style="{StaticResource OpsCaption}" Margin="0,0,0,5"/><TextBox x:Name="SearchBox" Style="{StaticResource OpsInput}" TextChanged="Filter_Changed" ToolTip="Search callsign, airport, route, or aircraft"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="AIRCRAFT" Style="{StaticResource OpsCaption}" Margin="0,0,0,5"/><ComboBox x:Name="AircraftFilter" Style="{StaticResource OpsCombo}" SelectionChanged="Filter_Changed"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="YEAR" Style="{StaticResource OpsCaption}" Margin="0,0,0,5"/><ComboBox x:Name="YearFilter" Style="{StaticResource OpsCombo}" SelectionChanged="Filter_Changed"/></StackPanel>
        <StackPanel Grid.Column="6"><TextBlock Text="SOURCE" Style="{StaticResource OpsCaption}" Margin="0,0,0,5"/><ComboBox x:Name="SourceFilter" Style="{StaticResource OpsCombo}" SelectionChanged="Filter_Changed"/></StackPanel>
        <StackPanel Grid.Column="8"><TextBlock Text="STATUS" Style="{StaticResource OpsCaption}" Margin="0,0,0,5"/><ComboBox x:Name="StatusFilter" Style="{StaticResource OpsCombo}" SelectionChanged="Filter_Changed"/></StackPanel>
        <Button Grid.Column="10" Content="CLEAR FILTERS" Style="{StaticResource OpsExit}" Padding="14,8" VerticalAlignment="Bottom" Click="ClearFilters_Click"/>
      </Grid>
    </Border>
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="13*" MinWidth="620"/><ColumnDefinition Width="8"/><ColumnDefinition Width="7*" MinWidth="330"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource OpsPanel}" Padding="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="FlightsGrid" Style="{StaticResource OpsGrid}" Margin="1" MinColumnWidth="70" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="FlightSelection_Changed" SizeChanged="FlightsGrid_SizeChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CALLSIGN" Binding="{Binding Callsign}" Width="165" SortMemberPath="Callsign"/>
              <DataGridTextColumn Header="DEPARTURE" Binding="{Binding Departure}" Width="165" SortMemberPath="Departure"/>
              <DataGridTextColumn Header="ARRIVAL" Binding="{Binding Arrival}" Width="165" SortMemberPath="Arrival"/>
              <DataGridTextColumn Header="AIRCRAFT" Binding="{Binding Aircraft}" Width="345" SortMemberPath="Aircraft"/>
              <DataGridTextColumn Header="DATE" Binding="{Binding ShortDate}" Width="270" SortMemberPath="StartedUtc"/>
              <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="180" SortMemberPath="DurationMinutes"/>
              <DataGridTemplateColumn Header="STATUS" Width="*" MinWidth="200" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="3" Padding="7,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="✈" Foreground="{StaticResource OpsYellow}" FontSize="36" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="NO FLIGHTS RECORDED YET" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock x:Name="EmptyDetail" Text="Completed and interrupted flight sessions will appear here." Style="{StaticResource OpsCaption}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#FF9690" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" TextAlignment="Center"/>
          <Border Grid.Row="1" Background="#071017" BorderBrush="#21313C" BorderThickness="0,1,0,0" Padding="12,7"><Grid><TextBlock x:Name="ResultsText" Text="SHOWING 0 OF 0 FLIGHTS" Style="{StaticResource OpsCaption}"/><TextBlock Text="SELECT A FLIGHT FOR DETAILS" Style="{StaticResource OpsCaption}" HorizontalAlignment="Right"/></Grid></Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>
      <Border Grid.Column="2" Style="{StaticResource OpsPanel}" Padding="0">
        <Grid>
          <StackPanel x:Name="NoSelectionState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✈" Foreground="#547083" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="SELECT A FLIGHT" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="Flight information and recorded events will appear here." Style="{StaticResource OpsCaption}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
          <Grid x:Name="DetailsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Border BorderBrush="#29404F" BorderThickness="0,0,0,1" Padding="16,12"><Grid><TextBlock Text="FLIGHT DETAILS" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="SemiBold"/><Border x:Name="DetailStatusBadge" HorizontalAlignment="Right" Background="#102019" BorderBrush="#356443" BorderThickness="1" CornerRadius="3" Padding="8,3"><TextBlock x:Name="DetailStatusText" Foreground="#75D88A" FontSize="10" FontWeight="SemiBold"/></Border></Grid></Border>
            <StackPanel Grid.Row="1" Margin="16,13,16,12"><TextBlock x:Name="DetailCallsignText" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DetailOriginText" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource OpsYellow}"/><TextBlock Text="DEPARTURE" Style="{StaticResource OpsCaption}"/></StackPanel><TextBlock Grid.Column="1" Text="→" Foreground="#7E9CB0" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="DetailDestinationText" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource OpsYellow}" HorizontalAlignment="Right"/><TextBlock Text="ARRIVAL" Style="{StaticResource OpsCaption}" HorizontalAlignment="Right"/></StackPanel></Grid></StackPanel>
            <Border Grid.Row="2" BorderBrush="#29404F" BorderThickness="0,1,0,1"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="16,10"><TextBlock Text="AIRCRAFT" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="DetailAircraftText" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="16,10"><TextBlock Text="SOURCE" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="DetailSourceText" Margin="0,4,0,0"/></StackPanel>
              <StackPanel Grid.Row="1" Margin="16,10"><TextBlock Text="DATE / STARTED UTC" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="DetailDateText" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="16,10"><TextBlock Text="DURATION" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="DetailDurationText" Margin="0,4,0,0"/></StackPanel>
            </Grid></Border>
            <Border Grid.Row="3" BorderBrush="#29404F" BorderThickness="0,0,0,1" Padding="16,10"><StackPanel><TextBlock Text="OPERATIONAL RECORD" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BLOCK / AIRBORNE / LANDING / IN" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="DetailTimesText" Margin="0,4,8,0" TextWrapping="Wrap" FontSize="11"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FUEL / LANDING DATA" Style="{StaticResource OpsCaption}"/><TextBlock x:Name="DetailPerformanceText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"/></StackPanel></Grid><TextBlock Text="ROUTE" Style="{StaticResource OpsCaption}" Margin="0,9,0,0"/><TextBlock x:Name="DetailRouteText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#B8C9D5" FontSize="11"/></StackPanel></Border>
            <Grid Grid.Row="4" Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="FULL EVENT TIMELINE" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="SemiBold"/><ScrollViewer Grid.Row="1" Margin="0,9,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl x:Name="DetailEventsList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#213946" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#83A9C1" FontSize="10"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Detail}" Foreground="#9CB0BF" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border x:Name="NoEventsNotice" Background="#0A1720" BorderBrush="#29404F" BorderThickness="1" Padding="11" Margin="0,4,0,0"><TextBlock x:Name="NoEventsText" Text="No detailed operational events were recorded for this flight." Foreground="#9CB0BF" TextWrapping="Wrap" FontSize="11"/></Border></StackPanel></ScrollViewer></Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
