<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Alpha6Ops.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <SolidColorBrush x:Key="OpsYellow" Color="#FFDA00" />
  <SolidColorBrush x:Key="OpsMuted" Color="#A3B0BE" />
  <SolidColorBrush x:Key="OpsLine" Color="#293A46" />
  <Style x:Key="OpsWindowCaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" /><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#C7D2DA" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#25323B" /><Setter Property="Foreground" Value="White" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OpsWindowCloseButton" TargetType="Button" BasedOn="{StaticResource OpsWindowCaptionButton}">
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="OpsWindow" TargetType="Window">
    <Setter Property="WindowStyle" Value="None" /><Setter Property="Background" Value="#071019" /><Setter Property="Foreground" Value="#F2F6FA" />
    <Setter Property="Icon" Value="Assets/Alpha6OPS.ico" /><Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border Background="#071019" BorderBrush="#293A46" BorderThickness="1">
            <Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /></Grid.RowDefinitions>
              <Border Background="#04090D" BorderBrush="#172630" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"><Image Source="{TemplateBinding Icon}" Width="18" Height="18" /><TextBlock Text="{TemplateBinding Title}" Foreground="#C7D2DA" FontFamily="Bahnschrift SemiCondensed" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <local:WindowCaptionButton Action="Minimize" Style="{StaticResource OpsWindowCaptionButton}" AutomationProperties.Name="Minimize"><Path Data="M 1,9 L 11,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12" Stretch="None" /></local:WindowCaptionButton>
                    <local:WindowCaptionButton x:Name="MaximizeButton" Action="Maximize" Style="{StaticResource OpsWindowCaptionButton}" AutomationProperties.Name="Maximize"><Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" /></local:WindowCaptionButton>
                    <local:WindowCaptionButton x:Name="RestoreButton" Action="Restore" Style="{StaticResource OpsWindowCaptionButton}" AutomationProperties.Name="Restore" Visibility="Collapsed"><Path Data="M 3,1 L 11,1 L 11,9 L 9,9 M 1,3 L 9,3 L 9,11 L 1,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="12" Height="12" Stretch="None" /></local:WindowCaptionButton>
                    <local:WindowCaptionButton Action="Close" Style="{StaticResource OpsWindowCloseButton}" AutomationProperties.Name="Close"><Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12" Stretch="None" /></local:WindowCaptionButton>
                  </StackPanel>
                </Grid>
              </Border>
              <AdornerDecorator Grid.Row="1"><ContentPresenter /></AdornerDecorator>
            </Grid>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" /><Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OpsPanel" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0D171F" />
          <GradientStop Color="#070D11" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource OpsLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="OpsTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="#F4F6FA" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="OpsCaption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource OpsMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- WPF shows FocusVisualStyle for keyboard navigation, not persistent mouse focus. -->
  <Style x:Key="OpsKeyboardFocus" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Grid Margin="3" IsHitTestVisible="False">
            <Rectangle Stroke="#04090D" StrokeThickness="3" RadiusX="2" RadiusY="2" />
            <Rectangle Stroke="{StaticResource OpsYellow}" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OpsButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OpsKeyboardFocus}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#15212B" />
    <Setter Property="Foreground" Value="#EEF2F6" />
    <Setter Property="BorderBrush" Value="#415362" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="15,10" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFDA00" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OpsPrimary" TargetType="Button" BasedOn="{StaticResource OpsButton}">
    <Setter Property="Background" Value="{StaticResource OpsYellow}" />
    <Setter Property="Foreground" Value="#090D10" />
    <Setter Property="BorderBrush" Value="#FFE653" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="OpsExit" TargetType="Button" BasedOn="{StaticResource OpsButton}">
    <Setter Property="Background" Value="#101B23" />
    <Setter Property="Foreground" Value="#F4F7F9" />
    <Setter Property="BorderBrush" Value="#415362" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource OpsYellow}" />
        <Setter Property="Foreground" Value="#080C0F" />
        <Setter Property="BorderBrush" Value="#FFE653" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="OpsLink" TargetType="Button" BasedOn="{StaticResource OpsButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#42ACFF" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="OpsNav" TargetType="Button" BasedOn="{StaticResource OpsButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="#AFBECC" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="15,12" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource OpsYellow}" />
        <Setter Property="Foreground" Value="#080C0F" />
        <Setter Property="BorderBrush" Value="#FFE653" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="OpsTile" TargetType="Button" BasedOn="{StaticResource OpsButton}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="#354956" />
    <Setter Property="Margin" Value="0,0,10,10" />
  </Style>
  <Style x:Key="OpsInput" TargetType="TextBox">
    <Setter Property="Background" Value="#0B141C" />
    <Setter Property="Foreground" Value="#F4F6FA" />
    <Setter Property="CaretBrush" Value="#FFDA00" />
    <Setter Property="BorderBrush" Value="#415362" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="OpsCombo" TargetType="ComboBox">
    <Setter Property="Background" Value="#0B141C" />
    <Setter Property="Foreground" Value="#F4F6FA" />
    <Setter Property="BorderBrush" Value="#415362" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}" /><Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="#AFC0CD" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#FFDA00" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="#0B141C" BorderBrush="#415362" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="#0B141C" /><Setter Property="Foreground" Value="#F4F6FA" /><Setter Property="Padding" Value="10,8" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#253846" /><Setter Property="Foreground" Value="White" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#314653" /><Setter Property="Foreground" Value="White" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OpsGrid" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#21313C" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#E9EFF5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="#0B141A" />
    <Setter Property="AlternatingRowBackground" Value="#111D25" />
    <Setter Property="RowHeight" Value="39" />
    <Setter Property="ColumnHeaderHeight" Value="32" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
    <Setter Property="FontSize" Value="12" />
    <Style.Resources>
      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#081117" />
        <Setter Property="Foreground" Value="#9EB0C0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="#263A46" />
            <Setter Property="Foreground" Value="White" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </Style.Resources>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="9" />
    <Setter Property="Background" Value="#071019" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="28">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#344B5C" CornerRadius="4" Margin="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="9" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
