<Window x:Class="Alpha6Ops.Desktop.OfpViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="SimBrief OFP" Icon="Assets/Alpha6OPS.ico" Width="1180" Height="840" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="#04090D" Foreground="#F2F6FA" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="OfpCaption" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="38"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C7D2DA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#25323B"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style x:Key="OfpCloseCaption" TargetType="Button" BasedOn="{StaticResource OfpCaption}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style x:Key="BookmarkButton" TargetType="Button" BasedOn="{StaticResource OpsLink}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="Foreground" Value="#D7E1E8"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#132531"/><Setter Property="Foreground" Value="{StaticResource OpsYellow}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
  <Border Background="#04090D" BorderBrush="#172630" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center"><Image Source="Assets/Alpha6OPS.ico" Width="18" Height="18"/><TextBlock Text="SIMBRIEF OFP" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource OfpCaption}" Content="—" FontFamily="Segoe UI" FontSize="13" Click="Minimize_Click"/><Button Style="{StaticResource OfpCaption}" Content="□" FontFamily="Segoe UI Symbol" FontSize="15" Click="Maximize_Click"/><Button Style="{StaticResource OfpCloseCaption}" Content="×" FontFamily="Segoe UI" FontSize="19" Click="Close_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Rectangle Width="5" Fill="{StaticResource OpsYellow}" Margin="0,1,12,1"/><TextBlock Text="OPERATIONAL FLIGHT PLAN" FontFamily="Bahnschrift SemiCondensed" FontSize="27"/></StackPanel><TextBlock x:Name="ReleaseText" Style="{StaticResource OpsCaption}" Margin="17,5,0,0"/></StackPanel><Button Grid.Column="1" Content="CLOSE" Style="{StaticResource OpsExit}" Padding="18,9" Click="Close_Click"/></Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="BookmarkColumn" Width="235"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="BookmarkPanel" Style="{StaticResource OpsPanel}" Padding="12"><DockPanel><Grid DockPanel.Dock="Top" Margin="3,2,3,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="BOOKMARKS" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="‹" Style="{StaticResource OpsLink}" Width="30" Height="28" Click="ToggleBookmarks_Click" ToolTip="Collapse bookmarks"/></Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="BookmarkItems"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding}" Style="{StaticResource BookmarkButton}" Click="Bookmark_Click"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
    <Button x:Name="ShowBookmarksButton" Visibility="Collapsed" Grid.Column="0" Width="42" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource OpsExit}" Click="ToggleBookmarks_Click" ToolTip="Show bookmarks" AutomationProperties.Name="Show OFP bookmarks"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M4,3 L10.5,3 C12,3 12,4 12,5 L12,21 C12,19.5 11,19 9.5,19 L4,19 Z M20,3 L13.5,3 C12,3 12,4 12,5 L12,21 C12,19.5 13,19 14.5,19 L20,19 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
    <Border Grid.Column="2" Style="{StaticResource OpsPanel}" Padding="0"><ScrollViewer x:Name="DocumentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="VerticalOnly" ScrollChanged="DocumentScroll_ScrollChanged"><StackPanel x:Name="DocumentContent" Margin="28"/></ScrollViewer></Border>
   </Grid>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="−" Style="{StaticResource OpsExit}" Width="42" Height="34" Click="ZoomOut_Click"/><TextBlock x:Name="ZoomText" Text="100%" Width="62" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Style="{StaticResource OpsExit}" Width="42" Height="34" Click="ZoomIn_Click"/><Button Content="FIT" Style="{StaticResource OpsExit}" Padding="14,7" Margin="8,0,0,0" Click="Fit_Click"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="DocumentStatusText" Style="{StaticResource OpsCaption}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="OpenPdfButton" Content="OPEN PDF EXTERNALLY" Style="{StaticResource OpsExit}" Padding="17,8" Click="OpenPdf_Click"/></StackPanel></Grid>
  </Grid>
 </Grid>
</Window>
