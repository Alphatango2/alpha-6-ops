<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup><InternalsVisibleTo Include="Alpha6Ops.MigrationChecks" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Alpha6Ops.RecoveryChecks" /></ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Alpha6OPS</AssemblyName>
    <Version>0.22.0</Version>
    <ApplicationIcon>Assets\Alpha6OPS.ico</ApplicationIcon>
    <Company>Alpha 6 Designs</Company>
    <Product>Alpha 6 OPS</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Content Include="MapV2/Web/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\Alpha6OPS.ico" />
    <ProjectReference Include="../Alpha6Ops.Core/Alpha6Ops.Core.csproj" />
    <EmbeddedResource Include="../../samples/delayed-flight.jsonl" LogicalName="delayed-flight.jsonl" />
    <EmbeddedResource Include="../../samples/on-time-flight.jsonl" LogicalName="on-time-flight.jsonl" />
    <EmbeddedResource Include="Assets/Map/ne_110m_land.geojson" LogicalName="ne_110m_land.geojson" />
    <EmbeddedResource Include="Assets/Map/ne_50m_land.geojson" LogicalName="ne_50m_land.geojson" />
    <EmbeddedResource Include="Assets/Map/ne_110m_land-mask.png" LogicalName="ne_110m_land-mask.png" />
    <EmbeddedResource Include="../../assets/airports/airports.tsv.gz" LogicalName="airports.tsv.gz" />
    <Content Include="../../assets/fleet/aircraft.sqlite" Link="fleet/aircraft.sqlite" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/alpha6.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/alpha6-mark.png" />
    <Resource Include="Assets/Dashboard/*.png" />
    <Resource Include="Assets/Sierra4/*.png" />
  </ItemGroup>
</Project>
