<Window x:Class="Alpha6Ops.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Alpha 6 OPS — Settings" Icon="Assets/Alpha6OPS.ico" Width="960" Height="700" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#071019" Foreground="#F2F6FA" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SettingsCaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C7D2DA"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#25323B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingsCloseCaptionButton" TargetType="Button" BasedOn="{StaticResource SettingsCaptionButton}">
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingsTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="#AFC0CD" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="17,12" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#172630" /><Setter Property="Foreground" Value="White" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#1B2831" /><Setter TargetName="TabChrome" Property="BorderBrush" Value="#FFDA00" /><Setter Property="Foreground" Value="#FFDA00" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsSection" TargetType="Border" BasedOn="{StaticResource OpsPanel}">
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </Window.Resources>
  <Border Background="#071019" BorderBrush="#2B3E4B" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
      <Border Background="#04090D" BorderBrush="#172630" BorderThickness="0,0,0,1">
        <Grid>
          <Image Source="Assets/Alpha6OPS.ico" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"/>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource SettingsCaptionButton}" Click="MinimizeWindow_Click" AutomationProperties.Name="Minimize Settings"><Viewbox Width="12" Height="12"><Canvas Width="12" Height="12"><Path Data="M 1,9 L 11,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Canvas></Viewbox></Button>
            <Button Style="{StaticResource SettingsCaptionButton}" Click="ToggleMaximizeWindow_Click" AutomationProperties.Name="Maximize or restore Settings"><Grid Width="12" Height="12"><Rectangle x:Name="MaximizeIcon" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/><Grid x:Name="RestoreIcon" Visibility="Collapsed"><Path Data="M 3,1 L 11,1 L 11,9 L 9,9 M 1,3 L 9,3 L 9,11 L 1,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Fill="#04090D"/></Grid></Grid></Button>
            <Button Style="{StaticResource SettingsCloseCaptionButton}" Click="CloseWindow_Click" AutomationProperties.Name="Close Settings"><Viewbox Width="12" Height="12"><Canvas Width="12" Height="12"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Canvas></Viewbox></Button>
          </StackPanel>
        </Grid>
      </Border>
  <Grid Grid.Row="1" Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="SETTINGS" FontFamily="Bahnschrift SemiCondensed" FontSize="32" />
      <TextBlock Text="Configure your local Alpha 6 OPS flight deck" Style="{StaticResource OpsCaption}" Margin="0,6,0,0" />
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="2" TabStripPlacement="Left" Background="Transparent" BorderBrush="#2B3E4B" BorderThickness="1">
      <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource SettingsTab}" /></TabControl.Resources>
      <TabItem Header="GENERAL">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
          <TextBlock Text="GENERAL" Style="{StaticResource OpsTitle}" FontSize="24" Margin="0,0,0,16" />
          <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="WINDOW BEHAVIOR" Style="{StaticResource OpsTitle}"/><TextBlock Text="The window size and maximized state are remembered. Minimize and Close keep OPS available in the system tray so flight monitoring can continue." Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,9,0,12"/><Button Content="MINIMIZE OPS TO SYSTEM TRAY" Style="{StaticResource OpsButton}" HorizontalAlignment="Left" Click="MinimizeToTray_Click"/></StackPanel></Border>
          <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="PILOT PROFILE" Style="{StaticResource OpsTitle}"/><TextBlock x:Name="PilotSummaryText" Style="{StaticResource OpsCaption}" Margin="0,9,0,12"/><Button Content="EDIT PILOT &amp; FLIGHT TOOLS" Style="{StaticResource OpsButton}" HorizontalAlignment="Left" Click="OpenFlightTools_Click"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="SIMULATOR">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="SIMULATOR" Style="{StaticResource OpsTitle}" FontSize="24" Margin="0,0,0,16"/>
          <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="MICROSOFT FLIGHT SIMULATOR 2024" Style="{StaticResource OpsTitle}"/><TextBlock x:Name="SimulatorStatusText" Foreground="#75D96A" Margin="0,9,0,7"/><TextBlock Text="The built-in SimConnect adapter reads aircraft identity, simulator UTC and flight-state telemetry. Automatic reconnect and telemetry-clock integrity checks remain active during a connected session." Style="{StaticResource OpsCaption}" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="FLIGHT TRACKING">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="FLIGHT TRACKING" Style="{StaticResource OpsTitle}" FontSize="24" Margin="0,0,0,16"/>
          <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="AUTOMATIC MONITORING" Style="{StaticResource OpsTitle}"/><TextBlock Text="Phase detection, flight journals, program health heartbeats, timeline recording and post-flight history are enabled for live sessions. Aircraft-specific ground profiles control stable block-in detection." Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="SIMBRIEF">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="SIMBRIEF" Style="{StaticResource OpsTitle}" FontSize="24" Margin="0,0,0,16"/>
          <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="FLIGHT PLAN IMPORT" Style="{StaticResource OpsTitle}"/><TextBlock x:Name="SimBriefStatusText" Foreground="#75D96A" Margin="0,9,0,7"/><TextBlock Text="The latest successful briefing is cached for offline recovery. Manage your Navigraph Alias or SimBrief username from Flight Tools." Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="OPEN FLIGHT TOOLS" Style="{StaticResource OpsButton}" HorizontalAlignment="Left" Click="OpenFlightTools_Click"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="PluginsTab" Header="PLUGINS">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="PLUGINS &amp; INTEGRATIONS" Style="{StaticResource OpsTitle}" FontSize="24"/><TextBlock Text="Installed integrations included with this version" Style="{StaticResource OpsCaption}" Margin="0,6,0,16"/>
          <Border Style="{StaticResource SettingsSection}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MSFS 2024 SIMCONNECT" Style="{StaticResource OpsTitle}"/><TextBlock Text="Live aircraft identity, simulator time and phase telemetry" Style="{StaticResource OpsCaption}" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="SimConnectPluginStatusText" Grid.Column="1" Text="BUILT IN" Foreground="#75D96A" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
          <Border Style="{StaticResource SettingsSection}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SIMBRIEF IMPORT" Style="{StaticResource OpsTitle}"/><TextBlock Text="Imports the latest generated operational flight plan" Style="{StaticResource OpsCaption}" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="SimBriefPluginStatusText" Grid.Column="1" Foreground="#75D96A" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
          <Border Style="{StaticResource SettingsSection}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DIAGNOSTICS &amp; FLIGHT HISTORY" Style="{StaticResource OpsTitle}"/><TextBlock Text="Crash reports, program monitoring, flight journals and SQLite indexes" Style="{StaticResource OpsCaption}" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="BUILT IN" Foreground="#75D96A" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
          <Border Style="{StaticResource SettingsSection}" BorderBrush="#594F20"><StackPanel><TextBlock Text="THIRD-PARTY PLUGIN PACKAGES" Style="{StaticResource OpsTitle}"/><TextBlock Text="A signed extension format and plugin catalog are planned. This build does not load arbitrary external code." Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="LogsDiagnosticsTab" Header="LOGS &amp; DIAGNOSTICS">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <TextBlock Text="LOGS &amp; DIAGNOSTICS" Style="{StaticResource OpsTitle}" FontSize="24" />
            <TextBlock Text="Flight records, health monitoring, exports, and recovery files" Style="{StaticResource OpsCaption}" Margin="0,6,0,18" />
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource SettingsSection}" Margin="0">
                <StackPanel>
                  <TextBlock Text="PROGRAM MONITOR" Style="{StaticResource OpsTitle}"/>
                  <TextBlock x:Name="ProgramHealthText" Foreground="#75D96A" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  <TextBlock Text="Records application health and SimConnect state so interrupted sessions can be diagnosed." Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource SettingsSection}" Margin="0">
                <StackPanel>
                  <TextBlock Text="FLIGHT LOGGING" Style="{StaticResource OpsTitle}"/>
                  <TextBlock x:Name="LoggingStatusText" Foreground="#FFDA00" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  <TextBlock Text="Live sessions save automatically. Export a readable JSON report when a flight needs review." Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource SettingsSection}">
              <StackPanel>
                <TextBlock Text="FLIGHT RECORDS &amp; REPORTS" Style="{StaticResource OpsTitle}"/>
                <TextBlock Text="Review completed sessions, inspect the indexed log catalog, or export the latest test-flight journal." Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,8,0,13"/>
                <WrapPanel>
                  <Button x:Name="FlightHistoryButton" Content="FLIGHT HISTORY" Style="{StaticResource OpsButton}" Click="OpenFlightHistory_Click" Margin="0,0,8,8"/>
                  <Button x:Name="LogDatabaseButton" Content="LOG DATABASE" Style="{StaticResource OpsButton}" Click="OpenLogDatabase_Click" Margin="0,0,8,8"/>
                  <Button x:Name="ExportLogButton" Content="EXPORT TEST LOG" Style="{StaticResource OpsButton}" Click="ExportLog_Click" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsSection}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                  <TextBlock Text="LOCAL DATA &amp; RECOVERY" Style="{StaticResource OpsTitle}"/>
                  <TextBlock x:Name="DataPathText" Style="{StaticResource OpsCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button Content="DATA FOLDER" Style="{StaticResource OpsButton}" Click="OpenDataFolder_Click" Margin="0,0,8,8"/>
                  <Button Content="CRASH REPORTS" Style="{StaticResource OpsButton}" Click="OpenCrashReports_Click" Margin="0,0,0,8"/>
                </WrapPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="ABOUT">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="ABOUT ALPHA 6 OPS" Style="{StaticResource OpsTitle}" FontSize="24" Margin="0,0,0,16"/>
          <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock x:Name="VersionText" Foreground="#FFDA00" FontSize="21"/><TextBlock Text="Flight simulation operations software by Alpha 6 Designs" Style="{StaticResource OpsCaption}" Margin="0,9,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
    </Grid>
  </Border>
</Window>
