<Window x:Class="Alpha6Ops.Desktop.ActiveFlightWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Enter Flight Manually" Style="{StaticResource OpsWindow}" Icon="Assets/Alpha6OPS.ico" Width="620" Height="720" ResizeMode="CanResize" MinWidth="580" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#071019" Foreground="#F2F6FA">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="ENTER FLIGHT MANUALLY" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Enter UTC with Z, or enter airport-local time with its UTC offset. A6OPS stores one unambiguous UTC instant." Foreground="#9EB0C0" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,11,14"><TextBlock Text="FLIGHT NUMBER" Style="{StaticResource OpsCaption}"/><TextBox x:Name="FlightNumberBox" Margin="0,6,0,0" AutomationProperties.Name="Flight number"/></StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="1" Margin="11,0,0,14"><TextBlock Text="REGISTRATION (OPTIONAL)" Style="{StaticResource OpsCaption}"/><TextBox x:Name="RegistrationBox" Margin="0,6,0,0" AutomationProperties.Name="Aircraft registration"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,11,14"><TextBlock Text="ORIGIN ICAO" Style="{StaticResource OpsCaption}"/><TextBox x:Name="OriginBox" Margin="0,6,0,0" MaxLength="4" AutomationProperties.Name="Origin ICAO"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="11,0,0,14"><TextBlock Text="DESTINATION ICAO" Style="{StaticResource OpsCaption}"/><TextBox x:Name="DestinationBox" Margin="0,6,0,0" MaxLength="4" AutomationProperties.Name="Destination ICAO"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,11,14"><TextBlock Text="DEPARTURE DATE / TIME" Style="{StaticResource OpsCaption}"/><TextBox x:Name="DepartureBox" Margin="0,6,0,0" AutomationProperties.Name="Planned departure date time and UTC offset"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="1" Margin="11,0,0,14"><TextBlock Text="ARRIVAL DATE / TIME" Style="{StaticResource OpsCaption}"/><TextBox x:Name="ArrivalBox" Margin="0,6,0,0" AutomationProperties.Name="Planned arrival date time and UTC offset"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,11,14"><TextBlock Text="DEPARTURE GATE" Style="{StaticResource OpsCaption}"/><TextBox x:Name="DepartureGateBox" Margin="0,6,0,0" MaxLength="6" AutomationProperties.Name="Departure gate"/></StackPanel>
    <StackPanel Grid.Row="3" Grid.Column="1" Margin="11,0,0,14"><TextBlock Text="ARRIVAL GATE" Style="{StaticResource OpsCaption}"/><TextBox x:Name="ArrivalGateBox" Margin="0,6,0,0" MaxLength="6" AutomationProperties.Name="Arrival gate"/></StackPanel>
   </Grid>
   <TextBlock Text="Examples: 2026-09-16 05:40Z (UTC) or 2026-09-16 15:40 +10:00 (airport local). Include the arrival date for overnight flights." Foreground="#91A4B4" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,16"/>
   <Border Background="#0A141C" BorderBrush="#293A46" BorderThickness="1" CornerRadius="3" Padding="14"><StackPanel><Grid><TextBlock Text="FILED ROUTE (OPTIONAL)" Style="{StaticResource OpsCaption}"/><Button Grid.Column="1" HorizontalAlignment="Right" Content="PASTE ROUTE" Style="{StaticResource OpsLink}" Padding="9,3" Click="PasteRoute_Click" AutomationProperties.Name="Paste filed route"/></Grid><TextBox x:Name="RouteBox" MinHeight="82" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="Filed route"/><TextBlock Text="Enter fixes, airways, SIDs, STARs, and speed or altitude changes. Mapping is shown only when coordinates are available." Foreground="#91A4B4" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
   <TextBlock x:Name="ErrorText" Foreground="#FF9690" TextWrapping="Wrap" MinHeight="28" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="4" BorderBrush="#293A46" BorderThickness="0,1,0,0" Padding="0,16,0,0"><Grid><TextBlock Text="MANUAL ASSIGNMENT" Style="{StaticResource OpsCaption}" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource OpsExit}" MinWidth="112" Height="42" Padding="20,10" Margin="0,0,12,0" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="SAVE ACTIVE FLIGHT" Style="{StaticResource OpsPrimary}" MinWidth="168" Height="42" Padding="22,10" Click="Save_Click"/></StackPanel></Grid></Border>
 </Grid>
</Window>
