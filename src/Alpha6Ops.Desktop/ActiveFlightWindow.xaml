<Window x:Class="Alpha6Ops.Desktop.ActiveFlightWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set active flight" Style="{StaticResource OpsWindow}" Icon="Assets/Alpha6OPS.ico" Width="560" Height="690" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#071019" Foreground="#F2F6FA">
  <StackPanel Margin="28">
    <TextBlock Text="Set active flight" FontSize="26" FontWeight="Bold"/>
    <TextBlock Text="Enter the operational assignment. Times use UTC and the simulator clock." Foreground="#9EB0C0" TextWrapping="Wrap" Margin="0,6,0,18"/>
    <Border Background="#0D171F" BorderBrush="#293A46" BorderThickness="1" Padding="12" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="IMPORT LATEST SIMBRIEF OFP" Foreground="#65E697" FontWeight="Bold" FontSize="11"/>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SimBriefUsernameBox" Padding="8" ToolTip="Navigraph Alias or SimBrief username"/><Button x:Name="ImportButton" Grid.Column="1" Content="Import" Margin="10,0,0,0" Click="Import_Click"/></Grid>
      <TextBlock x:Name="ImportStatusText" Text="Your username is stored locally. No Navigraph password is required." Foreground="#9EB0C0" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
    </StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="Flight number"/><TextBox x:Name="FlightNumberBox" Padding="8"/></StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Registration (optional)"/><TextBox x:Name="RegistrationBox" Padding="8"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="Origin ICAO"/><TextBox x:Name="OriginBox" Padding="8" MaxLength="4"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Destination ICAO"/><TextBox x:Name="DestinationBox" Padding="8" MaxLength="4"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="Planned departure UTC"/><TextBox x:Name="DepartureBox" Padding="8"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Planned arrival UTC"/><TextBox x:Name="ArrivalBox" Padding="8"/></StackPanel>
      <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="Departure gate"/><TextBox x:Name="DepartureGateBox" Padding="8" MaxLength="6"/></StackPanel>
      <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Arrival gate"/><TextBox x:Name="ArrivalGateBox" Padding="8" MaxLength="6"/></StackPanel>
    </Grid>
    <TextBlock Text="Format: YYYY-MM-DD HH:MM" Foreground="#91A4B4" FontSize="11"/>
    <TextBlock x:Name="ErrorText" Foreground="#FF9690" TextWrapping="Wrap" MinHeight="38" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save active flight" Background="#F9D928" Foreground="#071019" FontWeight="Bold" Click="Save_Click"/></StackPanel>
  </StackPanel>
</Window>
