<Window x:Class="Alpha6Ops.Desktop.FleetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Alpha 6 OPS — Aircraft database" Icon="Assets/Alpha6OPS.ico" Width="1120" Height="760" ResizeMode="CanResize" Background="#10120F" Foreground="#F0F0EB" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="DELTA AIR LINES / AIRCRAFT DATABASE" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Yellow}"/>
      <TextBlock x:Name="SummaryText" Margin="0,10,0,5"/>
      <TextBlock Text="Airfleets reference snapshot • mainline only • Active and Parked • not operational availability" Foreground="#BFC5B4" FontSize="12" TextWrapping="Wrap"/>
      <Grid Margin="0,20,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0"><TextBlock Text="Search registration, model or serial" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" FontSize="16" Padding="9" TextChanged="Filter_Changed" AutomationProperties.Name="Search registration model or serial"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Aircraft family" Margin="0,0,0,6"/><ComboBox x:Name="FamilyFilter" FontSize="15" Padding="8" SelectionChanged="Selection_Changed" AutomationProperties.Name="Aircraft family"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Fleet status" Margin="0,0,0,6"/><ComboBox x:Name="StatusFilter" FontSize="15" Padding="8" SelectionChanged="Selection_Changed" AutomationProperties.Name="Fleet status"/></StackPanel>
      </Grid>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock x:Name="CountText" Foreground="{StaticResource Yellow}"/><TextBlock x:Name="DetailText" Margin="0,8,0,12" TextWrapping="Wrap"/><WrapPanel><Button Content="Open selected Airfleets page" Click="Source_Click"/><Button Content="Close" Click="Close_Click"/></WrapPanel></StackPanel>
    <DataGrid x:Name="FleetGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="Aircraft_Changed" HeadersVisibility="Column" Background="#1B1E17" Foreground="#F0F0EB" RowBackground="#1B1E17" AlternatingRowBackground="#252A20" BorderBrush="#3B4133" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3B4133" RowHeight="36" EnableRowVirtualization="True" EnableColumnVirtualization="True">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#303628"/><Setter Property="Foreground" Value="#F9D928"/><Setter Property="Padding" Value="9"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.Resources>
      <DataGrid.Columns><DataGridTextColumn Header="Registration" Binding="{Binding Registration}" Width="115"/><DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="180" MinWidth="180"/><DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="120"/><DataGridTextColumn Header="MSN" Binding="{Binding SerialNumber}" Width="80"/><DataGridTextColumn Header="Line #" Binding="{Binding LineNumber}" Width="65"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Delivery (source)" Binding="{Binding DeliveryDate}" Width="140"/></DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
