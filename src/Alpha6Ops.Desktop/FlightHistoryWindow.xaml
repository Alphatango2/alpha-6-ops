<Window x:Class="Alpha6Ops.Desktop.FlightHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha 6 OPS — Flight history" Width="1050" Height="620" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#10120F" Foreground="#F0F0EB">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Flight history" FontSize="26" FontWeight="Bold"/>
      <TextBlock x:Name="DatabaseText" Foreground="#BFC5B4" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock Text="Every fixture replay run on this machine, with its phase milestones. Live SimConnect flights aren't logged here yet." Foreground="#8E9584" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Close" Click="Close_Click"/></StackPanel>
    <DataGrid x:Name="FlightsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#1B1E17" Foreground="#F0F0EB" BorderBrush="#3B4133" HorizontalGridLinesBrush="#3B4133" RowBackground="#1B1E17" AlternatingRowBackground="#23271D" RowHeight="34" ColumnHeaderHeight="32">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#282D22"/><Setter Property="Foreground" Value="#F9D928"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Pilot" Binding="{Binding Pilot}" Width="120"/>
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
        <DataGridTextColumn Header="Aircraft" Binding="{Binding Aircraft}" Width="90"/>
        <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="130"/>
        <DataGridTextColumn Header="Started UTC" Binding="{Binding StartedUtc}" Width="160"/>
        <DataGridTextColumn Header="Ended UTC" Binding="{Binding EndedUtc}" Width="160"/>
        <DataGridTextColumn Header="Final phase" Binding="{Binding FinalPhase}" Width="110"/>
        <DataGridTextColumn Header="Events" Binding="{Binding EventCount}" Width="70"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
