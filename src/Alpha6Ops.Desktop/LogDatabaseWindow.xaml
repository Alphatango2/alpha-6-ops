<Window x:Class="Alpha6Ops.Desktop.LogDatabaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha 6 OPS — Diagnostic files" Style="{StaticResource OpsWindow}" Icon="Assets/Alpha6OPS.ico" Width="1050" Height="620" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#071019" Foreground="#F2F6FA">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="Diagnostic file database" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="DatabaseText" Foreground="#9EB0C0" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Open selected file location" Click="Open_Click"/><Button Content="Close" Click="Close_Click"/></StackPanel>
    <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Background="#0B141A" Foreground="#F2F6FA" BorderBrush="#293A46" RowBackground="#0B141A" AlternatingRowBackground="#111D25">
      <DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/><DataGridTextColumn Header="Modified UTC" Binding="{Binding ModifiedUtc}" Width="210"/><DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="100"/><DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/></DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
