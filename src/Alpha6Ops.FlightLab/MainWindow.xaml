<Window x:Class="Alpha6Ops.FlightLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Alpha 6 Flight Lab v0.1" Icon="Assets/A6FL.ico" Width="1040" Height="720" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#050B10" Foreground="White">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#25323B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/></Trigger></Style.Triggers></Style>
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="54"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="0"/><Setter Property="ToolTipService.ShowDuration" Value="10000"/></Style>
  </Window.Resources>
  <Grid Background="#050B10"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="#04090D" BorderBrush="#172630" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center"><Image Source="Assets/A6FL.png" Width="24" Height="24"/><TextBlock Text="ALPHA 6 FLIGHT LAB" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#C7D2DA"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click" AutomationProperties.Name="Minimize Flight Lab"><Path Data="M 1,9 L 11,9" Stroke="#C7D2DA" StrokeThickness="1.2" Stretch="None"/></Button><Button Style="{StaticResource CaptionButton}" Click="ToggleMaximizeWindow_Click" AutomationProperties.Name="Maximize or restore Flight Lab"><Rectangle Width="10" Height="10" Stroke="#C7D2DA" StrokeThickness="1.1"/></Button><Button Style="{StaticResource CloseCaptionButton}" Click="Exit_Click" AutomationProperties.Name="Close Flight Lab"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="#F1F5F8" StrokeThickness="1.2" Stretch="None"/></Button></StackPanel>
    </Grid></Border>
  <Grid Grid.Row="1" Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="ALPHA 6 FLIGHT LAB" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Yellow}"/><TextBlock Text="Virtual flight telemetry and failure-injection console" Foreground="#9FB2C0" FontSize="13" Margin="0,5,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#0C171F" BorderBrush="#344B59" BorderThickness="1" CornerRadius="5" Padding="16,10"><StackPanel><TextBlock x:Name="ServerStatusText" Text="STARTING LOCAL LINK" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock Text="Connect from Alpha 6 OPS → Flight Deck" Foreground="#8EA4B4" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="#0A141B" BorderBrush="#2D424F" BorderThickness="1" CornerRadius="5" Padding="16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="VIRTUAL AIRCRAFT" Foreground="#91A7B7" FontSize="10"/><TextBox x:Name="AircraftBox" Text="Alpha 6 Test A321" Margin="0,6,0,0" TextChanged="Aircraft_Changed"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="SIMULATOR RATE" Foreground="#91A7B7" FontSize="10"/><ComboBox x:Name="RateBox" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="Rate_Changed"><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="10×" Tag="10"/><ComboBoxItem Content="60×" Tag="60"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="SIMULATOR UTC" Foreground="#91A7B7" FontSize="10"/><TextBlock x:Name="SimulatorTimeText" Text="00:00:00Z" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Yellow}" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#0A141B" BorderBrush="#2D424F" BorderThickness="1" CornerRadius="5" Padding="16"><StackPanel>
        <TextBlock Text="MANUAL FLIGHT PHASES" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Start at the gate, connect Alpha 6 OPS, then advance the aircraft." Foreground="#91A7B7" Margin="0,4,0,14"/>
        <UniformGrid Columns="3"><Button Content="AT GATE" Tag="AtGate" Click="Phase_Click"/><Button Content="ENGINE START" Tag="EngineStart" Click="Phase_Click"/><Button Content="PUSHBACK" Tag="Pushback" Click="Phase_Click"/><Button Content="TAXI OUT" Tag="TaxiOut" Click="Phase_Click"/><Button Content="TAKEOFF" Tag="Takeoff" Click="Phase_Click"/><Button Content="CLIMB" Tag="Climb" Click="Phase_Click"/><Button Content="CRUISE" Tag="Cruise" Click="Phase_Click"/><Button Content="DESCEND" Tag="Descend" Click="Phase_Click"/><Button Content="APPROACH" Tag="Approach" Click="Phase_Click"/><Button Content="LAND" Tag="Land" Click="Phase_Click"/><Button Content="TAXI TO GATE" Tag="TaxiIn" Click="Phase_Click"/><Button Content="PARK AT GATE" Tag="Complete" Click="Phase_Click"/></UniformGrid>
        <TextBlock Text="AUTOMATIC FLIGHT" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="PlaybackStatusText" Text="READY • 1× PLAYBACK" Foreground="#91A7B7" FontSize="10" Margin="0,0,0,8"/>
        <WrapPanel><Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Click="Play_Click" ToolTip="Play or resume the complete flight" AutomationProperties.Name="Play automatic flight"><Viewbox Width="18" Height="18"><Path Data="M 3,1 L 13,8 L 3,15 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox></Button><Button x:Name="PauseButton" Style="{StaticResource TransportButton}" Click="Pause_Click" ToolTip="Pause automatic flight" AutomationProperties.Name="Pause automatic flight"><Viewbox Width="18" Height="18"><Canvas Width="16" Height="16"><Rectangle Canvas.Left="3" Canvas.Top="2" Width="3.5" Height="12" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><Rectangle Canvas.Left="9.5" Canvas.Top="2" Width="3.5" Height="12" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox></Button><Button x:Name="FastForwardButton" Style="{StaticResource TransportButton}" Click="FastForward_Click" ToolTip="Toggle 4× flight playback" AutomationProperties.Name="Toggle fast forward"><Viewbox Width="20" Height="18"><Canvas Width="20" Height="16"><Path Data="M 1,2 L 9,8 L 1,14 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><Path Data="M 10,2 L 18,8 L 10,14 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox></Button><Button Content="GO-AROUND" Tag="GoAround" Click="Phase_Click"/><Button Content="DIVERSION" Click="Diversion_Click"/></WrapPanel>
      </StackPanel></Border>
      <StackPanel Grid.Column="2">
        <Border Background="#0A141B" BorderBrush="#2D424F" BorderThickness="1" CornerRadius="5" Padding="16"><StackPanel><TextBlock Text="LIVE TELEMETRY" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PhaseText" Text="AT GATE" FontSize="31" FontWeight="Bold" Foreground="{StaticResource Yellow}" Margin="0,12,0,0"/><TextBlock x:Name="TelemetryText" Text="0 kt • Brake set • Engines off" Foreground="#B6C7D3" FontSize="14" Margin="0,7,0,0"/><TextBlock x:Name="ScenarioText" Text="Ready for Alpha 6 OPS" Foreground="#77D889" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Background="#0A141B" BorderBrush="#2D424F" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="FAULT INJECTION" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Exercise reconnect, continuity, and recovery behavior." Foreground="#91A7B7" Margin="0,4,0,12"/><UniformGrid Columns="2"><Button x:Name="FreezeButton" Content="FREEZE DATA" Click="Freeze_Click"/><Button Content="DROP LINK" Click="DropLink_Click"/><Button Content="+10 MIN CLOCK JUMP" Click="ClockJump_Click"/><Button Content="CHANGE AIRCRAFT" Click="ChangeAircraft_Click"/><Button Content="SIMULATOR CRASH" Background="#361719" BorderBrush="#8F3D43" Click="CrashSimulator_Click"/><Button Content="RESTART LAB LINK" Click="RestartLink_Click"/></UniformGrid></StackPanel></Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LOCAL TEST TOOL • DATA NEVER LEAVES THIS PC • THIS DOES NOT EMULATE MICROSOFT'S SIMCONNECT PROTOCOL" Foreground="#6F8797" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Content="EXIT FLIGHT LAB" Click="Exit_Click" Padding="18,9" Margin="12,0,0,0" AutomationProperties.Name="Exit Alpha 6 Flight Lab"/></Grid>
  </Grid>
  </Grid>
</Window>
