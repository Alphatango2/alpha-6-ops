<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Alpha 6 OPS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Alpha 6 OPS home"><span class="mark">A6</span> ALPHA 6 <span class="muted">OPS</span></a>
        <nav aria-label="Main navigation">
            <a href="/Download">Download</a>
            @if (User.Identity?.IsAuthenticated == true) {
                <a href="/Account">My account</a>
                <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
            } else { <a href="/auth/login">Sign in</a> }
        </nav>
    </header>
    <main id="main">@RenderBody()</main>
    <footer><span>ALPHA 6 OPS · Built for virtual aviation</span><a href="/Support">Help &amp; account security</a></footer>
</body>
</html>
